---
import Layout from '../layouts/Layout.astro';
---

<Layout title="SIAC-JUS | Dirección Provincial de Justicia de Camagüey">
	<!-- APLICACIÓN PRINCIPAL -->
	<div id="app" class="min-h-screen flex flex-col bg-slate-100 text-slate-800 font-sans">
		
		<!-- ==================== CINTILLO GUBERNAMENTAL SUPERIOR ==================== -->
		<div class="bg-slate-950 text-slate-300 text-[11px] py-1.5 px-4 sm:px-6 border-b border-slate-800 flex items-center justify-between tracking-wide">
			<div class="flex items-center gap-2">
				<span class="font-bold text-white uppercase tracking-wider">República de Cuba</span>
				<span class="text-slate-500">•</span>
				<span class="text-slate-300">Ministerio de Justicia (MINJUS)</span>
			</div>
			<div class="hidden sm:flex items-center gap-3 text-slate-400 text-[10px]">
				<span>Sede Provincial de Camagüey</span>
				<span class="text-slate-600">•</span>
				<span id="fecha-oficial-hoy"></span>
			</div>
		</div>

		<!-- ==================== PANTALLA 1: ACCESO (LOGIN INSTITUCIONAL) ==================== -->
		<div id="view-login" class="min-h-[calc(100vh-32px)] flex items-center justify-center p-4 bg-gradient-to-b from-slate-900 via-[#0c2038] to-[#071526]">
			<div class="w-full max-w-md bg-white rounded-2xl shadow-2xl border border-slate-200/80 overflow-hidden">
				<!-- Cabecera de Login -->
				<div class="bg-[#0f2744] px-8 py-8 text-white text-center border-b border-slate-700/80 relative">
					<div class="w-16 h-16 bg-[#183c66] rounded-2xl border border-blue-400/20 flex items-center justify-center mx-auto mb-3 shadow-lg shadow-black/30 text-3xl">
						⚖️
					</div>
					<h1 class="text-lg font-extrabold tracking-tight text-white uppercase">Dirección Provincial de Justicia</h1>
					<p class="text-xs text-blue-200/90 font-medium mt-1">Provincia de Camagüey</p>
					<div class="mt-3 inline-block px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest bg-blue-500/20 text-blue-200 border border-blue-400/30">
						SIAC-JUS • Módulo Estadístico
					</div>
				</div>

				<!-- Formulario -->
				<form id="form-login" class="p-8 space-y-5">
					<div id="login-error" class="hidden p-3 rounded-lg bg-rose-50 border border-rose-200 text-rose-800 text-xs font-semibold flex items-center gap-2">
						<span>⚠️</span>
						<span>Credenciales incorrectas. Verifique el usuario y contraseña.</span>
					</div>

					<div>
						<label class="block text-[11px] font-bold text-slate-700 uppercase tracking-wider mb-1">
							Funcionario / Usuario
						</label>
						<input
							type="text"
							id="login-username"
							placeholder="Directora o Personal"
							required
							autocomplete="username"
							class="w-full px-3.5 py-2.5 text-sm rounded-lg border border-slate-300 focus:ring-2 focus:ring-[#0f2744] focus:border-[#0f2744] outline-none transition bg-slate-50 focus:bg-white"
						/>
					</div>

					<div>
						<label class="block text-[11px] font-bold text-slate-700 uppercase tracking-wider mb-1">
							Contraseña Institucional
						</label>
						<input
							type="password"
							id="login-password"
							placeholder="••••••••••••"
							required
							autocomplete="current-password"
							class="w-full px-3.5 py-2.5 text-sm rounded-lg border border-slate-300 focus:ring-2 focus:ring-[#0f2744] focus:border-[#0f2744] outline-none transition bg-slate-50 focus:bg-white"
						/>
					</div>

					<button
						type="submit"
						class="w-full py-2.5 px-4 rounded-lg bg-[#0f2744] hover:bg-[#16365c] active:bg-[#0c1f36] text-white font-bold text-sm shadow-md transition duration-150 flex items-center justify-center gap-2"
					>
						<span>Ingresar al Sistema</span>
						<span>→</span>
					</button>

					<!-- Accesos directos de demostración -->
					<div class="pt-4 border-t border-slate-100 space-y-2.5">
						<p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider text-center">
							Accesos Rápidos para Demostración Oficial
						</p>
						<div class="grid grid-cols-2 gap-2">
							<button
								type="button"
								id="btn-demo-directora"
								class="px-3 py-2 text-xs font-bold rounded-lg bg-indigo-50 text-indigo-900 border border-indigo-200 hover:bg-indigo-100 transition text-center flex items-center justify-center gap-1.5"
							>
								<span>👩‍⚖️</span> Directora
							</button>
							<button
								type="button"
								id="btn-demo-personal"
								class="px-3 py-2 text-xs font-bold rounded-lg bg-slate-100 text-slate-800 border border-slate-200 hover:bg-slate-200 transition text-center flex items-center justify-center gap-1.5"
							>
								<span>📋</span> Ventanilla
							</button>
						</div>
						<p class="text-[10px] text-slate-400 text-center font-mono">
							Contraseña: <strong>ASDasd123</strong>
						</p>
					</div>
				</form>
			</div>
		</div>

		<!-- ==================== PANTALLA PRINCIPAL DEL SISTEMA ==================== -->
		<div id="view-dashboard" class="hidden flex-1 flex flex-col">
			
			<!-- HEADER INSTITUCIONAL -->
			<header class="bg-[#0f2744] text-white border-b border-slate-800 sticky top-0 z-30 shadow-md">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-between gap-3">
					<div class="flex items-center gap-3">
						<div class="w-10 h-10 rounded-xl bg-[#1a3a60] border border-blue-400/30 flex items-center justify-center font-bold text-xl text-white shadow">
							⚖️
						</div>
						<div>
							<div class="flex items-center gap-2">
								<h2 class="font-extrabold text-sm sm:text-base tracking-tight leading-tight">Web Estadística Justicia</h2>
								<span id="role-badge" class="px-2 py-0.5 rounded text-[10px] font-extrabold uppercase tracking-wide"></span>
							</div>
							<p class="text-[11px] text-blue-200">Dirección Provincial de Justicia de Camagüey</p>
						</div>
					</div>

					<div class="flex items-center gap-3">
						<div class="hidden sm:block text-right">
							<p id="user-display-name" class="text-xs font-bold text-slate-100"></p>
							<p id="user-display-role" class="text-[10px] text-blue-300"></p>
						</div>
						<button
							id="btn-logout"
							class="px-3 py-1.5 rounded-lg bg-slate-800/80 hover:bg-slate-700 text-slate-200 hover:text-white text-xs font-semibold border border-slate-600 transition flex items-center gap-1.5"
						>
							<span>🚪</span> Cerrar Sesión
						</button>
					</div>
				</div>

				<!-- BARRA DE NAVEGACIÓN POR PESTAÑAS (SOLO 4 PESTAÑAS - DOCUMENTACIÓN ELIMINADA) -->
				<div class="bg-[#09192c] border-t border-slate-700/60 px-4 sm:px-6">
					<nav class="max-w-7xl mx-auto flex space-x-1 sm:space-x-2 overflow-x-auto py-1" id="main-nav">
						<button
							data-tab="tab-registro"
							class="nav-tab px-3.5 py-2 text-xs font-bold rounded-md transition text-slate-300 hover:text-white flex items-center gap-2"
						>
							<span>📝</span> Registrar Comparecencia
						</button>
						<button
							data-tab="tab-expedientes"
							class="nav-tab px-3.5 py-2 text-xs font-bold rounded-md transition text-slate-300 hover:text-white flex items-center gap-2"
						>
							<span>📂</span> Expedientes Radicados
						</button>
						<button
							data-tab="tab-auditoria"
							id="nav-tab-auditoria"
							class="nav-tab px-3.5 py-2 text-xs font-bold rounded-md transition text-slate-300 hover:text-white flex items-center gap-2"
						>
							<span>⚖️</span> Bandeja de Auditoría Provincial
							<span id="badge-pendientes-count" class="px-1.5 py-0.2 rounded-full text-[10px] font-extrabold bg-amber-500 text-slate-950">0</span>
						</button>
						<button
							data-tab="tab-matriz"
							id="nav-tab-matriz"
							class="nav-tab px-3.5 py-2 text-xs font-bold rounded-md transition text-slate-300 hover:text-white flex items-center gap-2"
						>
							<span>📊</span> Matriz Estadística Anual (20 Col)
						</button>
					</nav>
				</div>
			</header>

			<!-- CONTENIDO PRINCIPAL DE PESTAÑAS -->
			<main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6">
				
				<!-- ==================== PESTAÑA 1: FORMULARIO DE REGISTRO ==================== -->
				<section id="tab-registro" class="tab-pane space-y-6">
					<div class="bg-white rounded-xl p-6 sm:p-8 shadow-sm border border-slate-200">
						
						<!-- Encabezado de Acta Oficial -->
						<div class="flex flex-col sm:flex-row sm:items-center justify-between pb-5 border-b border-slate-200 gap-2 mb-6">
							<div>
								<div class="flex items-center gap-2">
									<span class="text-blue-900 font-bold text-xs uppercase tracking-widest bg-blue-50 px-2.5 py-1 rounded border border-blue-200">
										Acta Oficial de Comparecencia
									</span>
								</div>
								<h3 class="text-xl font-black text-slate-900 mt-1">Recepción y Radicación de Asesoría Jurídica</h3>
								<p class="text-xs text-slate-500">Formulario normativo de atención ciudadana (Regla Técnica RN-02)</p>
							</div>
							<div class="text-right">
								<span class="text-xs font-mono font-bold text-slate-600 bg-slate-100 px-3 py-1.5 rounded-lg border border-slate-200 inline-block" id="label-reloj-atencion">
									Horario Oficial
								</span>
							</div>
						</div>

						<form id="form-nuevo-expediente" class="space-y-6">
							
							<!-- I. DATOS DE RADICACIÓN -->
							<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 bg-slate-50/80 p-4 rounded-xl border border-slate-200">
								<div>
									<label class="block text-[11px] font-extrabold text-slate-700 uppercase tracking-wider mb-1">
										No. de Expediente (Único)
									</label>
									<input
										type="text"
										id="case-no"
										readonly
										class="w-full px-3 py-2 bg-slate-200 text-slate-900 font-mono font-extrabold text-sm rounded-lg border border-slate-300 outline-none cursor-not-allowed tracking-wider"
									/>
									<p class="text-[10px] text-slate-500 mt-1">Consecutivo ministerial automático</p>
								</div>

								<div>
									<label class="block text-[11px] font-extrabold text-slate-700 uppercase tracking-wider mb-1">
										Fecha de Atención
									</label>
									<input
										type="date"
										id="case-date"
										required
										class="w-full px-3 py-2 text-sm rounded-lg border border-slate-300 bg-white focus:ring-2 focus:ring-[#0f2744] outline-none font-medium"
									/>
								</div>

								<div>
									<label class="block text-[11px] font-extrabold text-slate-700 uppercase tracking-wider mb-1">
										Especialista que Atiende
									</label>
									<input
										type="text"
										id="case-responsable"
										required
										class="w-full px-3 py-2 text-sm rounded-lg border border-slate-300 bg-white focus:ring-2 focus:ring-[#0f2744] outline-none font-medium"
									/>
								</div>
							</div>

							<!-- II. GENERALES DEL COMPARECIENTE -->
							<div class="space-y-3">
								<h4 class="text-xs font-black text-[#0f2744] uppercase tracking-wider flex items-center gap-1.5 border-b border-slate-100 pb-1">
									<span>👤</span> I. Generales del Ciudadano Compareciente
								</h4>

								<div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
									<div class="sm:col-span-1">
										<label class="block text-[10px] font-bold text-slate-600 uppercase mb-1">
											Nombre y Apellidos <span class="text-rose-600">*</span>
										</label>
										<input
											type="text"
											id="case-ciudadano-nombre"
											placeholder="Ej. Juan Pérez Martínez"
											required
											class="w-full px-3 py-2 text-sm rounded-lg border border-slate-300 bg-white focus:ring-2 focus:ring-[#0f2744] outline-none"
										/>
									</div>
									<div>
										<label class="block text-[10px] font-bold text-slate-600 uppercase mb-1">
											Carnet de Identidad (11 dígitos) <span class="text-rose-600">*</span>
										</label>
										<input
											type="text"
											id="case-ciudadano-ci"
											placeholder="00000000000"
											maxlength="11"
											required
											class="w-full px-3 py-2 text-sm font-mono tracking-widest rounded-lg border border-slate-300 bg-white focus:ring-2 focus:ring-[#0f2744] outline-none"
										/>
									</div>
									<div>
										<label class="block text-[10px] font-bold text-slate-600 uppercase mb-1">
											Municipio de Residencia <span class="text-rose-600">*</span>
										</label>
										<select
											id="case-ciudadano-municipio"
											required
											class="w-full px-3 py-2 text-sm rounded-lg border border-slate-300 bg-white focus:ring-2 focus:ring-[#0f2744] outline-none font-medium"
										>
											<option value="">Seleccione Municipio...</option>
											<option value="Camagüey">Camagüey (Cabecera)</option>
											<option value="Florida">Florida</option>
											<option value="Nuevitas">Nuevitas</option>
											<option value="Guáimaro">Guáimaro</option>
											<option value="Carlos M. de Céspedes">Carlos M. de Céspedes</option>
											<option value="Esmeralda">Esmeralda</option>
											<option value="Jimaguayú">Jimaguayú</option>
											<option value="Minas">Minas</option>
											<option value="Najasa">Najasa</option>
											<option value="Sibanicú">Sibanicú</option>
											<option value="Santa Cruz del Sur">Santa Cruz del Sur</option>
											<option value="Vertientes">Vertientes</option>
											<option value="Sierra de Cubitas">Sierra de Cubitas</option>
										</select>
									</div>
								</div>

								<div>
									<label class="block text-[10px] font-bold text-slate-600 uppercase mb-1">
										Fundamentos del Asunto Planteado (Hechos y Petición) <span class="text-rose-600">*</span>
									</label>
									<textarea
										id="case-fundamentos"
										rows="4"
										required
										placeholder="Relato circunstanciado de los hechos expuestos por el ciudadano, pretensión solicitada y documentos exhibidos en la comparecencia..."
										class="w-full px-3.5 py-2.5 text-sm rounded-lg border border-slate-300 bg-white focus:ring-2 focus:ring-[#0f2744] outline-none leading-relaxed"
									></textarea>
								</div>
							</div>

							<!-- III. DETERMINACIÓN DE COMPETENCIA (INTERRUPTOR FUNCIONAL MEJORADO) -->
							<div class="p-5 rounded-xl border-2 transition duration-200 bg-slate-50 border-slate-300" id="box-competencia">
								<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
									<div>
										<h4 class="text-sm font-extrabold text-[#0f2744] uppercase tracking-wider flex items-center gap-2">
											<span>⚖️</span> II. Examen de Competencia Jurisdiccional (Regla RN-01)
										</h4>
										<p class="text-xs text-slate-600 mt-0.5">
											Determine si el objeto de la comparecencia es competencia funcional del Ministerio de Justicia.
										</p>
									</div>
									<!-- Botones Selector de Competencia -->
									<div class="flex items-center gap-2 bg-slate-200/80 p-1.5 rounded-xl">
										<button
											type="button"
											id="btn-compete-si"
											class="px-5 py-2 rounded-lg text-xs font-extrabold uppercase tracking-wide transition shadow-sm bg-[#15803d] text-white"
										>
											✓ SÍ COMPETE
										</button>
										<button
											type="button"
											id="btn-compete-no"
											class="px-5 py-2 rounded-lg text-xs font-extrabold uppercase tracking-wide transition text-slate-600 hover:text-slate-900"
										>
											✕ NO COMPETE
										</button>
									</div>
								</div>

								<!-- Alerta cuando No Compete -->
								<div id="alert-no-compete" class="hidden mt-4 p-3.5 rounded-lg bg-amber-50 border border-amber-300 text-amber-900 text-xs">
									<div class="flex items-start gap-2">
										<span class="text-base leading-none">⚠️</span>
										<div>
											<strong class="font-extrabold">Descarte Jurisdiccional Automático (RN-01):</strong>
											Este trámite no corresponde al Ministerio de Justicia. El expediente se archivará directamente con estado 
											<span class="font-mono font-bold bg-amber-200/60 px-1.5 py-0.5 rounded">No Compete</span>.
											Contabilizará en <em>Total Casos Atendidos</em> en la Matriz Estadística sin alterar las columnas de materias ni vías.
										</div>
									</div>
								</div>
							</div>

							<!-- IV. ENCUADRAMIENTO JURÍDICO Y VULNERABILIDAD (BOTONES 100% FUNCIONALES) -->
							<div id="seccion-clasificaciones" class="space-y-6">
								
								<!-- Selección de Materia -->
								<div>
									<div class="flex items-center justify-between mb-2">
										<label class="block text-xs font-black text-[#0f2744] uppercase tracking-wider">
											III. Materia Jurídica Aplicable <span class="text-rose-600">*</span>
										</label>
										<span class="text-[11px] text-slate-500 font-medium">Seleccione una de las 5 materias</span>
									</div>

									<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-2.5" id="grid-materias">
										<button
											type="button"
											data-materia="Civil"
											class="btn-materia-card text-left p-3.5 rounded-xl border-2 transition flex flex-col justify-between h-full bg-slate-900 text-white border-slate-900 shadow-sm"
										>
											<span class="font-extrabold text-xs flex items-center gap-1.5">
												<span>🏠</span> Civil
											</span>
											<span class="text-[10px] text-slate-300 mt-1.5 leading-snug">Viviendas, herencias, patrimonio y contratos civiles.</span>
										</button>

										<button
											type="button"
											data-materia="Familiar"
											class="btn-materia-card text-left p-3.5 rounded-xl border-2 transition flex flex-col justify-between h-full bg-white text-slate-800 border-slate-200 hover:border-slate-400"
										>
											<span class="font-extrabold text-xs flex items-center gap-1.5">
												<span>👨‍👩‍👧</span> Familiar
											</span>
											<span class="text-[10px] text-slate-500 mt-1.5 leading-snug">Código de las Familias, alimentos, guarda y divorcios.</span>
										</button>

										<button
											type="button"
											data-materia="Trabajo y Seguridad Social"
											class="btn-materia-card text-left p-3.5 rounded-xl border-2 transition flex flex-col justify-between h-full bg-white text-slate-800 border-slate-200 hover:border-slate-400"
										>
											<span class="font-extrabold text-xs flex items-center gap-1.5">
												<span>💼</span> Trabajo y Seg.
											</span>
											<span class="text-[10px] text-slate-500 mt-1.5 leading-snug">Conflictos laborales, pensiones por edad o invalidez.</span>
										</button>

										<button
											type="button"
											data-materia="Mercantil"
											class="btn-materia-card text-left p-3.5 rounded-xl border-2 transition flex flex-col justify-between h-full bg-white text-slate-800 border-slate-200 hover:border-slate-400"
										>
											<span class="font-extrabold text-xs flex items-center gap-1.5">
												<span>🏬</span> Mercantil
											</span>
											<span class="text-[10px] text-slate-500 mt-1.5 leading-snug">MIPYMES, cooperativas CNA y contratos comerciales.</span>
										</button>

										<button
											type="button"
											data-materia="Administrativo"
											class="btn-materia-card text-left p-3.5 rounded-xl border-2 transition flex flex-col justify-between h-full bg-white text-slate-800 border-slate-200 hover:border-slate-400"
										>
											<span class="font-extrabold text-xs flex items-center gap-1.5">
												<span>🏛️</span> Administrativo
											</span>
											<span class="text-[10px] text-slate-500 mt-1.5 leading-snug">Vivienda estatal, Planificación Física y Registro Civil.</span>
										</button>
									</div>
								</div>

								<!-- Selección de Vulnerabilidad -->
								<div>
									<div class="flex items-center justify-between mb-2">
										<label class="block text-xs font-black text-[#0f2744] uppercase tracking-wider">
											IV. Identificación de Vulnerabilidad Social <span class="text-rose-600">*</span>
										</label>
										<span class="text-[11px] text-slate-500 font-medium">Atención prioritaria según siglas oficiales</span>
									</div>

									<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-2.5" id="grid-vulns">
										<button
											type="button"
											data-vuln="NNA"
											class="btn-vuln-card text-left p-3 rounded-xl border-2 transition flex flex-col justify-between h-full bg-white text-slate-800 border-slate-200 hover:border-slate-400"
										>
											<div class="flex items-center justify-between">
												<span class="font-mono font-black text-xs text-blue-900 bg-blue-100 px-2 py-0.5 rounded">NNA</span>
												<span class="text-[10px] text-slate-400">&lt; 18 años</span>
											</div>
											<span class="font-bold text-xs mt-1.5 text-slate-800">Niño, Niña, Adolescente</span>
										</button>

										<button
