		// Handlers de Navegación
		function setupNavHandlers() {
			document.querySelectorAll('.nav-tab').forEach(tab => {
				tab.addEventListener('click', () => {
					const target = tab.dataset.tab;
					switchTab(target);
				});
			});

			const searchInput = document.getElementById('search-mis-expedientes');
			if (searchInput) {
				searchInput.addEventListener('input', () => renderizarTablaMisExpedientes());
			}

			const filterAudit = document.getElementById('filter-auditoria-estado');
			if (filterAudit) {
				filterAudit.addEventListener('change', () => renderizarBandejaAuditoria());
			}

			const searchAuditoria = document.getElementById('search-auditoria');
			if (searchAuditoria) {
				searchAuditoria.addEventListener('input', () => renderizarBandejaAuditoria());
			}
		}

		function switchTab(tabId) {
			document.querySelectorAll('.tab-pane').forEach(el => el.classList.add('hidden'));
			const target = document.getElementById(tabId);
			if (target) target.classList.remove('hidden');

			document.querySelectorAll('.nav-tab').forEach(tab => {
				if (tab.dataset.tab === tabId) {
					tab.classList.add('bg-[#143254]', 'text-white');
					tab.classList.remove('text-slate-300');
				} else {
					tab.classList.remove('bg-[#143254]', 'text-white');
					tab.classList.add('text-slate-300');
				}
			});
		}

