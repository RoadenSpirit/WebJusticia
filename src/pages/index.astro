		// Envío de Formulario de Radicación
		function setupFormSubmit() {
			const form = document.getElementById('form-nuevo-expediente');
			if (!form) return;

			form.addEventListener('submit', async (e) => {
				e.preventDefault();

				const noExp = document.getElementById('case-no').value.trim();
				const fecha = document.getElementById('case-date').value;
				const nombre = document.getElementById('case-ciudadano-nombre').value.trim();
				const ci = document.getElementById('case-ciudadano-ci').value.trim();
				const direccion = document.getElementById('case-ciudadano-direccion').value.trim();
				const municipio = document.getElementById('case-ciudadano-municipio').value;
				const telefono = document.getElementById('case-ciudadano-telefono').value.trim();
				const fundamentos = document.getElementById('case-fundamentos').value.trim();

				// Vulnerabilidades marcadas
				const vulns = [];
				document.querySelectorAll('.vuln-check:checked').forEach(chk => {
					vulns.push(chk.value);
				});

				const viaSolucion = document.getElementById('case-via-propuesta')?.value || 'Proceso Judicial';

				const payload = {
					no_expediente: noExp,
					fecha_atencion: fecha,
					ciudadano_nombre: nombre,
					ciudadano_ci: ci,
					ciudadano_direccion: direccion,
					ciudadano_municipio: municipio,
					ciudadano_telefono: telefono,
					fundamentos: fundamentos,
					es_competente: appState.isCompetente,
					materia: appState.isCompetente ? appState.selectedMateria : null,
					vulnerabilidades: appState.isCompetente ? vulns : [],
					via_solucion: appState.isCompetente ? viaSolucion : null,
					usuario_actual: appState.user ? appState.user.username : 'Personal'
				};

				try {
					const res = await fetch(`${API_BASE}/expedientes.php`, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify(payload)
					});

					if (res.ok) {
						const data = await res.json();
						if (data.success) {
							mostrarToast(`Expediente ${noExp} radicado exitosamente`);
							form.reset();
							sugerirNumeroExpediente();
							cargarExpedientesDesdeServidor();
							switchTab('tab-expedientes');
							return;
						} else {
							alert(data.error || 'Error al radicar');
							return;
						}
					} else {
						const errData = await res.json();
						alert(errData.error || 'Error en el servidor');
						return;
					}
				} catch (err) {
					// Fallback local
					const newCase = {
						id: Date.now(),
						no_expediente: noExp,
						fecha_atencion: fecha,
						ciudadano_nombre: nombre,
						ciudadano_ci: ci,
						ciudadano_direccion: direccion,
						ciudadano_municipio: municipio,
						ciudadano_telefono: telefono,
						fundamentos: fundamentos,
						es_competente: appState.isCompetente,
						materia: appState.isCompetente ? appState.selectedMateria : null,
						vulnerabilidades: appState.isCompetente ? vulns : [],
						via_solucion: appState.isCompetente ? viaSolucion : null,
						responsable: null,
						estado_caso: appState.isCompetente ? 'Radicado' : 'No Compete',
						apto_pago: false
					};
					appState.cases.unshift(newCase);
					localStorage.setItem('siac_jus_cached_cases', JSON.stringify(appState.cases));
					mostrarToast(`Expediente ${noExp} radicado (modo local)`);
					form.reset();
					sugerirNumeroExpediente();
					renderizarTodo();
					switchTab('tab-expedientes');
				}
			});
		}

		// Modales y Acciones
		function setupModalHandlers() {
			// Cerrar Ver Ficha
			document.getElementById('btn-cerrar-ver-ficha')?.addEventListener('click', cerrarModalVerFicha);
			document.getElementById('btn-cerrar-ver-ficha-2')?.addEventListener('click', cerrarModalVerFicha);

			// Cerrar Auditoría
			document.getElementById('btn-cerrar-auditoria')?.addEventListener('click', cerrarModalAuditoria);

			// Cerrar Edición
			document.getElementById('btn-cerrar-editar-modal')?.addEventListener('click', cerrarModalEditar);
			document.getElementById('btn-cancelar-editar-modal')?.addEventListener('click', cerrarModalEditar);

			// Asignar Responsable en Auditoría
			document.getElementById('btn-confirmar-responsable')?.addEventListener('click', async () => {
				const id = document.getElementById('audit-case-id').value;
				const resp = document.getElementById('audit-input-responsable').value.trim();
				if (!resp) {
					alert('Debe escribir el nombre del especialista asignado');
					return;
				}

				try {
					const res = await fetch(`${API_BASE}/expedientes.php?action=asignar_responsable`, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ id, responsable: resp, usuario_actual: appState.user.username })
					});
					if (res.ok) {
						mostrarToast('Responsable asignado. Trámite en curso.');
						cerrarModalAuditoria();
						cargarExpedientesDesdeServidor();
						return;
					}
				} catch (e) {}

				// Fallback local
				const c = appState.cases.find(x => x.id == id);
				if (c) {
					c.responsable = resp;
					c.estado_caso = 'En Trámite';
					localStorage.setItem('siac_jus_cached_cases', JSON.stringify(appState.cases));
					mostrarToast('Responsable asignado (local).');
					cerrarModalAuditoria();
					renderizarTodo();
				}
			});

			// Actualizar Condición de Pago
			document.getElementById('btn-guardar-pago')?.addEventListener('click', async () => {
				const id = document.getElementById('audit-case-id').value;
				const isApto = document.getElementById('radio-pago-si').checked;

				try {
					const res = await fetch(`${API_BASE}/expedientes.php?action=set_apto_pago`, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ id, apto_pago: isApto, usuario_actual: appState.user.username })
					});
					if (res.ok) {
						mostrarToast('Condición de pago actualizada.');
						cargarExpedientesDesdeServidor();
						return;
					}
				} catch (e) {}

				const c = appState.cases.find(x => x.id == id);
				if (c) {
					c.apto_pago = isApto;
					localStorage.setItem('siac_jus_cached_cases', JSON.stringify(appState.cases));
					mostrarToast('Condición de pago actualizada (local).');
					renderizarTodo();
				}
			});

			// Concluir Expediente
			document.getElementById('btn-concluir-expediente')?.addEventListener('click', async () => {
				const id = document.getElementById('audit-case-id').value;
				const nota = document.getElementById('audit-input-nota-conclusion').value.trim();

				try {
					const res = await fetch(`${API_BASE}/expedientes.php?action=concluir`, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ id, nota_conclusion: nota, usuario_actual: appState.user.username })
					});
					if (res.ok) {
						mostrarToast('Expediente concluido satisfactoriamente.');
						cerrarModalAuditoria();
						cargarExpedientesDesdeServidor();
						return;
					}
				} catch (e) {}

				const c = appState.cases.find(x => x.id == id);
				if (c) {
					c.estado_caso = 'Concluido';
					c.nota_conclusion = nota;
					localStorage.setItem('siac_jus_cached_cases', JSON.stringify(appState.cases));
					mostrarToast('Expediente concluido (local).');
					cerrarModalAuditoria();
					renderizarTodo();
				}
			});

			// Enviar a Papelera (Desechar)
			document.getElementById('btn-enviar-papelera')?.addEventListener('click', async () => {
				const id = document.getElementById('audit-case-id').value;
				const motivo = prompt('Por favor, ingrese el motivo de la baja del expediente:');
				if (motivo === null) return;

				try {
					const res = await fetch(`${API_BASE}/expedientes.php`, {
						method: 'DELETE',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ id, motivo, usuario_actual: appState.user.username })
					});
					if (res.ok) {
						mostrarToast('Expediente enviado a la papelera.');
						cerrarModalAuditoria();
						cargarExpedientesDesdeServidor();
						return;
					}
				} catch (e) {}

				// Fallback local
				const idx = appState.cases.findIndex(x => x.id == id);
				if (idx !== -1) {
					const item = appState.cases.splice(idx, 1)[0];
					item.motivo_eliminacion = motivo;
					item.usuario_eliminacion = appState.user.username;
					appState.papelera.unshift(item);
					localStorage.setItem('siac_jus_cached_cases', JSON.stringify(appState.cases));
					mostrarToast('Expediente enviado a la papelera (local).');
					cerrarModalAuditoria();
					renderizarTodo();
				}
			});

			// Descargar PDF desde modal
			document.getElementById('btn-audit-descargar-pdf')?.addEventListener('click', () => {
				const id = document.getElementById('audit-case-id').value;
				window.open(`${API_BASE}/pdf.php?id=${id}&format=pdf`, '_blank');
			});

			// Ver trazas en modal
			document.getElementById('btn-ver-trazas-historial')?.addEventListener('click', async () => {
				const id = document.getElementById('audit-case-id').value;
				const box = document.getElementById('box-trazas-desplegable');
				const list = document.getElementById('lista-trazas-contenido');
				box.classList.toggle('hidden');

				if (!box.classList.contains('hidden')) {
					list.innerHTML = 'Cargando trazas...';
					try {
						const res = await fetch(`${API_BASE}/expedientes.php?action=trazas&id=${id}`);
						if (res.ok) {
							const data = await res.json();
							if (data.trazas && data.trazas.length > 0) {
								list.innerHTML = data.trazas.map(t => `
									<div class="p-1.5 bg-white rounded border border-slate-200">
										<div class="flex justify-between text-[10px] text-slate-500">
											<span><strong>${t.usuario}</strong> • ${t.accion}</span>
											<span>${t.fecha_hora}</span>
										</div>
										<div class="text-slate-800 mt-0.5">${t.detalles}</div>
									</div>
								`).join('');
								return;
							}
						}
					} catch (e) {}
					list.innerHTML = '<div class="text-slate-500">Sin modificaciones registradas aún.</div>';
				}
			});

			// Guardar cambios en Modal de Edición
			document.getElementById('form-editar-modal')?.addEventListener('submit', async (e) => {
				e.preventDefault();
				const id = document.getElementById('edit-modal-id').value;
				const noExp = document.getElementById('edit-modal-no').value.trim();
				const fecha = document.getElementById('edit-modal-fecha').value;
				const ciudadano = document.getElementById('edit-modal-ciudadano').value.trim();
				const ci = document.getElementById('edit-modal-ci').value.trim();
				const dir = document.getElementById('edit-modal-dir').value.trim();
				const tel = document.getElementById('edit-modal-tel').value.trim();
				const fund = document.getElementById('edit-modal-fundamentos').value.trim();
				const materia = document.getElementById('edit-modal-materia').value;
				const via = document.getElementById('edit-modal-via').value;

				const payload = {
					id,
					no_expediente: noExp,
					fecha_atencion: fecha,
					ciudadano_nombre: ciudadano,
					ciudadano_ci: ci,
					ciudadano_direccion: dir,
					ciudadano_telefono: tel,
					fundamentos: fund,
					materia: materia,
					via_solucion: via,
					usuario_actual: appState.user.username
				};

				try {
					const res = await fetch(`${API_BASE}/expedientes.php`, {
						method: 'PUT',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify(payload)
					});
					if (res.ok) {
						mostrarToast('Expediente actualizado y traza registrada.');
						cerrarModalEditar();
						cargarExpedientesDesdeServidor();
						return;
					}
				} catch (e) {}

				// Fallback local
				const c = appState.cases.find(x => x.id == id);
				if (c) {
					c.no_expediente = noExp;
					c.fecha_atencion = fecha;
					c.ciudadano_nombre = ciudadano;
					c.ciudadano_ci = ci;
					c.ciudadano_direccion = dir;
					c.ciudadano_telefono = tel;
					c.fundamentos = fund;
					c.materia = materia;
					c.via_solucion = via;
					localStorage.setItem('siac_jus_cached_cases', JSON.stringify(appState.cases));
					mostrarToast('Expediente actualizado (local).');
					cerrarModalEditar();
					renderizarTodo();
				}
			});
		}

		// Funciones Globales para Botones en Tablas
		window.abrirModalVerFicha = function(id) {
			const c = appState.cases.find(x => x.id == id);
			if (!c) return;

			document.getElementById('modal-ver-no-expediente').textContent = `Expediente: ${c.no_expediente}`;
			document.getElementById('modal-ver-fecha').textContent = c.fecha_atencion;
			document.getElementById('modal-ver-municipio').textContent = c.ciudadano_municipio;
			document.getElementById('modal-ver-responsable').textContent = c.responsable || 'Pendiente de asignación';
			document.getElementById('modal-ver-estado').textContent = c.estado_caso;
			document.getElementById('modal-ver-estado').className = `font-bold ${getBadgeColorClase(c.estado_caso)} px-2 py-0.5 rounded text-[10px]`;
			
			document.getElementById('modal-ver-ciudadano').textContent = c.ciudadano_nombre;
			document.getElementById('modal-ver-ci').textContent = `CI: ${c.ciudadano_ci || 'No aportado'}`;
			document.getElementById('modal-ver-dir').textContent = `Dirección: ${c.ciudadano_direccion || 'No consignada'} • Tel: ${c.ciudadano_telefono || 'No aportado'}`;

			document.getElementById('modal-ver-materia').textContent = c.materia || 'No Compete';
			const vulns = Array.isArray(c.vulnerabilidades) ? c.vulnerabilidades.join(', ') : '';
			document.getElementById('modal-ver-vuln').textContent = vulns || 'Ninguna';
			document.getElementById('modal-ver-fundamentos').textContent = c.fundamentos;

			const viaBox = document.getElementById('modal-ver-via-container');
			if (c.via_solucion) {
				viaBox.classList.remove('hidden');
				document.getElementById('modal-ver-via').textContent = c.via_solucion;
			} else {
				viaBox.classList.add('hidden');
			}

			const notaBox = document.getElementById('modal-ver-nota-container');
			if (c.nota_conclusion) {
				notaBox.classList.remove('hidden');
				document.getElementById('modal-ver-nota').textContent = c.nota_conclusion;
			} else {
				notaBox.classList.add('hidden');
			}

			document.getElementById('btn-ver-pdf-direct').onclick = () => {
				window.open(`${API_BASE}/pdf.php?id=${c.id}&format=pdf`, '_blank');
			};

			document.getElementById('modal-ver-ficha').classList.remove('hidden');
		};

		function cerrarModalVerFicha() {
			document.getElementById('modal-ver-ficha').classList.add('hidden');
		}

		window.abrirModalAuditoria = function(id) {
			const c = appState.cases.find(x => x.id == id);
			if (!c) return;

			document.getElementById('audit-case-id').value = c.id;
			document.getElementById('audit-display-no').textContent = c.no_expediente;
			document.getElementById('audit-display-fecha').textContent = c.fecha_atencion;
			document.getElementById('audit-display-ciudadano').textContent = c.ciudadano_nombre;
			document.getElementById('audit-display-estado').textContent = c.estado_caso;
			document.getElementById('audit-display-estado').className = `font-bold ${getBadgeColorClase(c.estado_caso)} px-2 py-0.5 rounded text-[10px]`;

			document.getElementById('audit-input-responsable').value = c.responsable || '';
			document.getElementById('audit-input-nota-conclusion').value = c.nota_conclusion || '';

			if (c.apto_pago) {
				document.getElementById('radio-pago-si').checked = true;
				document.getElementById('badge-pago-status').textContent = 'APTO PARA PAGO';
				document.getElementById('badge-pago-status').className = 'text-[10px] font-bold bg-amber-200 text-amber-950 px-2 py-0.5 rounded';
			} else {
				document.getElementById('radio-pago-no').checked = true;
				document.getElementById('badge-pago-status').textContent = 'NO APTO / EXENTO';
				document.getElementById('badge-pago-status').className = 'text-[10px] font-bold bg-slate-200 text-slate-700 px-2 py-0.5 rounded';
			}

			// Ocultar caja de trazas al abrir
			document.getElementById('box-trazas-desplegable').classList.add('hidden');

			document.getElementById('modal-auditoria').classList.remove('hidden');
		};

		function cerrarModalAuditoria() {
			document.getElementById('modal-auditoria').classList.add('hidden');
		}

		window.abrirModalEditar = function(id) {
			const c = appState.cases.find(x => x.id == id);
			if (!c) return;

			document.getElementById('edit-modal-id').value = c.id;
			document.getElementById('edit-modal-no').value = c.no_expediente;
			document.getElementById('edit-modal-fecha').value = c.fecha_atencion;
			document.getElementById('edit-modal-ciudadano').value = c.ciudadano_nombre;
			document.getElementById('edit-modal-ci').value = c.ciudadano_ci || '';
			document.getElementById('edit-modal-dir').value = c.ciudadano_direccion || '';
			document.getElementById('edit-modal-tel').value = c.ciudadano_telefono || '';
			document.getElementById('edit-modal-fundamentos').value = c.fundamentos || '';
			document.getElementById('edit-modal-materia').value = c.materia || 'Civil';
			document.getElementById('edit-modal-via').value = c.via_solucion || 'Proceso Judicial';

			document.getElementById('modal-editar-expediente').classList.remove('hidden');
		};

		function cerrarModalEditar() {
			document.getElementById('modal-editar-expediente').classList.add('hidden');
		}

		window.restaurarExpediente = async function(id) {
			if (!confirm('¿Desea restaurar este expediente a la bandeja activa?')) return;

			try {
				const res = await fetch(`${API_BASE}/expedientes.php?action=restaurar`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ id, usuario_actual: appState.user.username })
				});
				if (res.ok) {
					mostrarToast('Expediente restaurado con éxito.');
					cargarExpedientesDesdeServidor();
					return;
				}
			} catch (e) {}

			// Fallback local
			const idx = appState.papelera.findIndex(x => x.id == id);
			if (idx !== -1) {
				const item = appState.papelera.splice(idx, 1)[0];
				delete item.motivo_eliminacion;
				delete item.usuario_eliminacion;
				appState.cases.unshift(item);
				localStorage.setItem('siac_jus_cached_cases', JSON.stringify(appState.cases));
				mostrarToast('Expediente restaurado (local).');
				renderizarTodo();
			}
		};

		function mostrarToast(msg) {
			const toast = document.getElementById('toast');
			const toastMsg = document.getElementById('toast-msg');
			if (!toast || !toastMsg) return;

			toastMsg.textContent = msg;
			toast.className = 'fixed bottom-5 right-5 z-50 px-4 py-3 rounded-lg shadow-xl text-xs font-bold text-white flex items-center gap-2 transition duration-200 bg-[#0c2340] border border-blue-400';
			toast.classList.remove('hidden');

			setTimeout(() => {
				toast.classList.add('hidden');
			}, 3500);
		}
	</script>
</Layout>
