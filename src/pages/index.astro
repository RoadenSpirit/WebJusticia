		// ==================== PERSISTENCIA ====================
		function getStoredCases() {
			const raw = localStorage.getItem(STORAGE_KEY_CASES);
			if (!raw) {
				localStorage.setItem(STORAGE_KEY_CASES, JSON.stringify(DEMO_CASES));
				return DEMO_CASES;
			}
			return JSON.parse(raw);
		}

		function saveStoredCases(cases) {
			localStorage.setItem(STORAGE_KEY_CASES, JSON.stringify(cases));
			refreshAllViews();
		}

		function getAuthUser() {
			const raw = localStorage.getItem(STORAGE_KEY_AUTH);
			return raw ? JSON.parse(raw) : null;
		}

		function setAuthUser(user) {
			if (user) {
				localStorage.setItem(STORAGE_KEY_AUTH, JSON.stringify(user));
			} else {
				localStorage.removeItem(STORAGE_KEY_AUTH);
			}
		}

		// ==================== ESTADO INTERACTIVO DEL FORMULARIO ====================
		let isCompetente = true;
		let selectedMateria = 'Civil';
		let selectedVuln = 'PAM';

		// ==================== INICIALIZACIÓN ====================
		function initApp() {
			// Mostrar fecha oficial
			const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
			const fechaStr = new Date().toLocaleDateString('es-ES', options);
			const fechaOficialEl = document.getElementById('fecha-oficial-hoy');
			if (fechaOficialEl) {
				fechaOficialEl.textContent = fechaStr.charAt(0).toUpperCase() + fechaStr.slice(1);
			}

			setupAuthHandlers();
			setupNavHandlers();
			setupFormSelectors();
			setupFormSubmit();
			setupModalHandlers();

			const user = getAuthUser();
			if (user) {
				showDashboard(user);
			} else {
				showLogin();
			}
		}

		function showLogin() {
			document.getElementById('view-login').classList.remove('hidden');
			document.getElementById('view-dashboard').classList.add('hidden');
		}

		function showDashboard(user) {
			document.getElementById('view-login').classList.add('hidden');
			document.getElementById('view-dashboard').classList.remove('hidden');

			const roleBadge = document.getElementById('role-badge');
			const userNameEl = document.getElementById('user-display-name');
			const userRoleEl = document.getElementById('user-display-role');
			const navAuditoria = document.getElementById('nav-tab-auditoria');
			const navMatriz = document.getElementById('nav-tab-matriz');

			userNameEl.textContent = user.name;
			userRoleEl.textContent = user.roleDescription;

			if (user.role === 'directora') {
				roleBadge.textContent = 'Dirección Provincial';
				roleBadge.className = 'px-2 py-0.5 rounded text-[10px] font-black uppercase tracking-wide bg-amber-400 text-slate-950';
				navAuditoria.classList.remove('hidden');
				navMatriz.classList.remove('hidden');
				switchTab('tab-auditoria');
			} else {
				roleBadge.textContent = 'Atención Ciudadana (Ventanilla)';
				roleBadge.className = 'px-2 py-0.5 rounded text-[10px] font-black uppercase tracking-wide bg-blue-600 text-white';
				navAuditoria.classList.add('hidden');
				navMatriz.classList.add('hidden');
				switchTab('tab-registro');
			}

			document.getElementById('case-responsable').value = user.name;
			refreshNextCaseNumber();
			refreshAllViews();
		}

		function switchTab(tabId) {
			document.querySelectorAll('.tab-pane').forEach(el => el.classList.add('hidden'));
			const target = document.getElementById(tabId);
			if (target) target.classList.remove('hidden');

			document.querySelectorAll('.nav-tab').forEach(tab => {
				if (tab.dataset.tab === tabId) {
					tab.classList.add('bg-[#1a3a60]', 'text-white', 'shadow-sm');
					tab.classList.remove('text-slate-300');
				} else {
					tab.classList.remove('bg-[#1a3a60]', 'text-white', 'shadow-sm');
					tab.classList.add('text-slate-300');
				}
			});

			if (tabId === 'tab-registro') {
				refreshNextCaseNumber();
			}
		}

		function refreshNextCaseNumber() {
			const cases = getStoredCases();
			const year = new Date().getFullYear();
			const nextNum = String(cases.length + 1).padStart(4, '0');
			document.getElementById('case-no').value = `EXP-${year}-${nextNum}`;
			document.getElementById('case-date').value = new Date().toISOString().split('T')[0];
		}

		// ==================== AUTENTICACIÓN ====================
		function setupAuthHandlers() {
			const formLogin = document.getElementById('form-login');
			const loginError = document.getElementById('login-error');

			formLogin.addEventListener('submit', (e) => {
				e.preventDefault();
				const u = document.getElementById('login-username').value.trim().toLowerCase();
				const p = document.getElementById('login-password').value.trim();

				if (p !== 'ASDasd123') {
					loginError.classList.remove('hidden');
					return;
				}

				if (u === 'directora') {
					loginError.classList.add('hidden');
					const user = { role: 'directora', name: 'Dra. Mercedes Calunga', roleDescription: 'Directora Provincial de Justicia' };
					setAuthUser(user);
					showDashboard(user);
					showToast('Sesión iniciada: Dirección Provincial de Camagüey');
				} else if (u === 'personal' || u === 'ventanilla') {
					loginError.classList.add('hidden');
					const user = { role: 'personal', name: 'Lic. Yaima Rodríguez', roleDescription: 'Especialista de Ventanilla 1' };
					setAuthUser(user);
					showDashboard(user);
					showToast('Sesión iniciada: Atención a la Ciudadanía');
				} else {
					loginError.classList.remove('hidden');
				}
			});

			// Botones Demo
			document.getElementById('btn-demo-directora').addEventListener('click', () => {
				document.getElementById('login-username').value = 'Directora';
				document.getElementById('login-password').value = 'ASDasd123';
				formLogin.dispatchEvent(new Event('submit'));
			});

			document.getElementById('btn-demo-personal').addEventListener('click', () => {
				document.getElementById('login-username').value = 'Personal';
				document.getElementById('login-password').value = 'ASDasd123';
				formLogin.dispatchEvent(new Event('submit'));
			});

			document.getElementById('btn-logout').addEventListener('click', () => {
				setAuthUser(null);
				showLogin();
				showToast('Sesión cerrada');
			});
		}

		function setupNavHandlers() {
			document.querySelectorAll('.nav-tab').forEach(tab => {
				tab.addEventListener('click', () => switchTab(tab.dataset.tab));
			});
		}

		// ==================== SELECTORES INTERACTIVOS Y BOTONES ====================
		function setupFormSelectors() {
			const btnSi = document.getElementById('btn-compete-si');
			const btnNo = document.getElementById('btn-compete-no');
			const secClasif = document.getElementById('seccion-clasificaciones');
			const alertNoComp = document.getElementById('alert-no-compete');
			const boxComp = document.getElementById('box-competencia');

			// Selector Competente SÍ
			btnSi.addEventListener('click', () => {
				isCompetente = true;
				btnSi.className = 'px-5 py-2 rounded-lg text-xs font-extrabold uppercase tracking-wide transition shadow-sm bg-[#15803d] text-white';
				btnNo.className = 'px-5 py-2 rounded-lg text-xs font-extrabold uppercase tracking-wide transition text-slate-600 hover:text-slate-900';
				secClasif.classList.remove('hidden');
				alertNoComp.classList.add('hidden');
				boxComp.className = 'p-5 rounded-xl border-2 transition duration-200 bg-slate-50 border-slate-300';
			});

			// Selector Competente NO
			btnNo.addEventListener('click', () => {
				isCompetente = false;
				btnNo.className = 'px-5 py-2 rounded-lg text-xs font-extrabold uppercase tracking-wide transition shadow-sm bg-slate-800 text-white';
				btnSi.className = 'px-5 py-2 rounded-lg text-xs font-extrabold uppercase tracking-wide transition text-slate-600 hover:text-slate-900';
				secClasif.classList.add('hidden');
				alertNoComp.classList.remove('hidden');
				boxComp.className = 'p-5 rounded-xl border-2 transition duration-200 bg-amber-50/50 border-amber-300';
			});

			// Botones de Materia
			const materiaBtns = document.querySelectorAll('.btn-materia-card');
			materiaBtns.forEach(btn => {
				btn.addEventListener('click', () => {
					selectedMateria = btn.dataset.materia;
					materiaBtns.forEach(b => {
						if (b.dataset.materia === selectedMateria) {
							b.className = 'btn-materia-card text-left p-3.5 rounded-xl border-2 transition flex flex-col justify-between h-full bg-[#0f2744] text-white border-[#0f2744] shadow-md';
							const sub = b.querySelector('span:last-child');
							if (sub) sub.className = 'text-[10px] text-blue-200 mt-1.5 leading-snug';
						} else {
							b.className = 'btn-materia-card text-left p-3.5 rounded-xl border-2 transition flex flex-col justify-between h-full bg-white text-slate-800 border-slate-200 hover:border-slate-400';
							const sub = b.querySelector('span:last-child');
							if (sub) sub.className = 'text-[10px] text-slate-500 mt-1.5 leading-snug';
						}
					});
				});
			});

			// Botones de Vulnerabilidad
			const vulnBtns = document.querySelectorAll('.btn-vuln-card');
			vulnBtns.forEach(btn => {
				btn.addEventListener('click', () => {
					selectedVuln = btn.dataset.vuln;
					vulnBtns.forEach(b => {
						if (b.dataset.vuln === selectedVuln) {
							b.className = 'btn-vuln-card text-left p-3 rounded-xl border-2 transition flex flex-col justify-between h-full bg-[#0f2744] text-white border-[#0f2744] shadow-md';
							const title = b.querySelector('span.text-xs');
							if (title) title.className = 'font-bold text-xs mt-1.5 text-white';
							const tag = b.querySelector('span.font-mono');
							if (tag) tag.className = 'font-mono font-black text-xs text-amber-200 bg-white/20 px-2 py-0.5 rounded';
						} else {
							b.className = 'btn-vuln-card text-left p-3 rounded-xl border-2 transition flex flex-col justify-between h-full bg-white text-slate-800 border-slate-200 hover:border-slate-400';
							const title = b.querySelector('span.text-xs');
							if (title) title.className = 'font-bold text-xs mt-1.5 text-slate-800';
							const tag = b.querySelector('span.font-mono');
							if (tag) tag.className = 'font-mono font-black text-xs text-blue-900 bg-blue-100 px-2 py-0.5 rounded';
						}
					});
				});
			});
		}

		// ==================== ENVÍO DEL FORMULARIO ====================
		function setupFormSubmit() {
			const form = document.getElementById('form-nuevo-expediente');

			form.addEventListener('submit', (e) => {
				e.preventDefault();

				const noExp = document.getElementById('case-no').value;
				const fecha = document.getElementById('case-date').value;
				const responsable = document.getElementById('case-responsable').value.trim();
				const ciudadano = document.getElementById('case-ciudadano-nombre').value.trim();
				const ci = document.getElementById('case-ciudadano-ci').value.trim();
				const municipio = document.getElementById('case-ciudadano-municipio').value;
				const fundamentos = document.getElementById('case-fundamentos').value.trim();

				if (!ciudadano || !ci || !municipio || !fundamentos) {
					alert('Por favor complete todos los campos obligatorios del compareciente.');
					return;
				}

				let materia = null;
				let vuln = null;
				let estado = 'No Compete';

				if (isCompetente) {
					materia = selectedMateria;
					vuln = selectedVuln;
					estado = 'Pendiente';
				}

				const newCase = {
					id: noExp,
					fecha,
					responsable,
					ciudadano,
					ci,
					municipio,
					fundamentos,
					competente: isCompetente,
					materia,
					vulnerabilidad: vuln,
					via: null,
					estado
				};

				const cases = getStoredCases();
				cases.unshift(newCase);
				saveStoredCases(cases);

				// Limpiar
				document.getElementById('case-ciudadano-nombre').value = '';
				document.getElementById('case-ciudadano-ci').value = '';
				document.getElementById('case-ciudadano-municipio').value = '';
				document.getElementById('case-fundamentos').value = '';
				document.getElementById('btn-compete-si').click();

				refreshNextCaseNumber();
				showToast(`Expediente ${noExp} radicado satisfactoriamente`);
				switchTab('tab-expedientes');
			});

			// Filtros de búsqueda
			document.getElementById('search-mis-expedientes').addEventListener('input', (e) => {
				renderMisExpedientes(e.target.value.toLowerCase());
			});

			document.getElementById('filter-auditoria-estado').addEventListener('change', (e) => {
				renderAuditoria(e.target.value);
			});

			// Cargar Datos Demo
			document.getElementById('btn-seed-data').addEventListener('click', () => {
				saveStoredCases(DEMO_CASES);
				showToast('Casos de muestra restablecidos');
			});
		}

		// ==================== MODALES ====================
		function setupModalHandlers() {
			// Modal Ver Ficha
			const modalVer = document.getElementById('modal-ver-ficha');
			const closeVer1 = document.getElementById('btn-cerrar-ver-ficha');
			const closeVer2 = document.getElementById('btn-cerrar-ver-ficha-2');
			[closeVer1, closeVer2].forEach(btn => btn.addEventListener('click', () => modalVer.classList.add('hidden')));

			// Modal Auditoría
			const modalAudit = document.getElementById('modal-auditoria');
			const closeAudit1 = document.getElementById('btn-cerrar-auditoria');
			const closeAudit2 = document.getElementById('btn-cerrar-auditoria-2');
			[closeAudit1, closeAudit2].forEach(btn => btn.addEventListener('click', () => modalAudit.classList.add('hidden')));

			// Formulario Auditoría y Dictamen
			const formAudit = document.getElementById('form-dictamen-auditoria');
			formAudit.addEventListener('submit', (e) => {
				e.preventDefault();
				const caseId = document.getElementById('audit-case-id').value;
				const via = document.getElementById('audit-select-via').value;
				const estado = document.getElementById('audit-select-estado').value;
				const fund = document.getElementById('audit-edit-fundamentos').value.trim();
				const mat = document.getElementById('audit-edit-materia').value;
				const vuln = document.getElementById('audit-edit-vuln').value;

				const cases = getStoredCases();
				const idx = cases.findIndex(c => c.id === caseId);
				if (idx !== -1) {
					cases[idx].fundamentos = fund;
					cases[idx].materia = mat;
					cases[idx].vulnerabilidad = vuln;
					cases[idx].via = via;
					cases[idx].estado = estado;
					saveStoredCases(cases);
					modalAudit.classList.add('hidden');
					showToast(`Dictamen emitido para expediente ${caseId}`);
				}
			});

			// Anular Caso
			document.getElementById('btn-eliminar-caso').addEventListener('click', () => {
				const caseId = document.getElementById('audit-case-id').value;
				const motivo = prompt('Escriba el motivo institucional obligatorio para anular el expediente:');
				if (motivo && motivo.trim().length >= 5) {
					let cases = getStoredCases();
					cases = cases.filter(c => c.id !== caseId);
					saveStoredCases(cases);
					modalAudit.classList.add('hidden');
					showToast(`Expediente ${caseId} anulado`);
				} else if (motivo !== null) {
					alert('Debe especificar un motivo válido de al menos 5 caracteres.');
				}
			});
		}

		function abrirFichaLectura(caseItem) {
			document.getElementById('modal-ver-no-expediente').textContent = `Ficha: ${caseItem.id}`;
			document.getElementById('modal-ver-fecha').textContent = caseItem.fecha;
			document.getElementById('modal-ver-municipio').textContent = caseItem.municipio || 'Camagüey';
			document.getElementById('modal-ver-responsable').textContent = caseItem.responsable;
			
			const estadoEl = document.getElementById('modal-ver-estado');
			estadoEl.innerHTML = getStatusBadge(caseItem.estado);

			document.getElementById('modal-ver-ciudadano').textContent = caseItem.ciudadano;
			document.getElementById('modal-ver-ci').textContent = `Carnet de Identidad: ${caseItem.ci || '—'}`;

			const boxClasif = document.getElementById('modal-ver-box-clasif');
			if (!caseItem.competente) {
				boxClasif.classList.add('hidden');
			} else {
				boxClasif.classList.remove('hidden');
				document.getElementById('modal-ver-materia').textContent = caseItem.materia || '—';
				document.getElementById('modal-ver-vuln').textContent = caseItem.vulnerabilidad || '—';
			}

			document.getElementById('modal-ver-fundamentos').textContent = caseItem.fundamentos;

			const viaContainer = document.getElementById('modal-ver-via-container');
			if (caseItem.via) {
				viaContainer.classList.remove('hidden');
				document.getElementById('modal-ver-via').textContent = caseItem.via;
			} else {
				viaContainer.classList.add('hidden');
			}

			document.getElementById('modal-ver-ficha').classList.remove('hidden');
		}

		function abrirAuditoriaDirectora(caseItem) {
			document.getElementById('audit-case-id').value = caseItem.id;
			document.getElementById('audit-display-no').textContent = caseItem.id;
			document.getElementById('audit-display-fecha').textContent = caseItem.fecha;
			document.getElementById('audit-display-municipio').textContent = caseItem.municipio || 'Camagüey';
			document.getElementById('audit-display-responsable').textContent = caseItem.responsable;
			document.getElementById('audit-edit-fundamentos').value = caseItem.fundamentos;

			const boxClasif = document.getElementById('audit-box-clasificaciones');
			if (!caseItem.competente) {
				boxClasif.classList.add('hidden');
			} else {
				boxClasif.classList.remove('hidden');
				document.getElementById('audit-edit-materia').value = caseItem.materia || 'Civil';
				document.getElementById('audit-edit-vuln').value = caseItem.vulnerabilidad || 'PAM';
			}

			document.getElementById('audit-select-via').value = caseItem.via || '';
			document.getElementById('audit-select-estado').value = (caseItem.estado === 'Pendiente' ? 'Resuelto' : caseItem.estado);

			document.getElementById('modal-auditoria').classList.remove('hidden');
		}

		// ==================== RENDERIZADO DE TABLAS ====================
		function refreshAllViews() {
			const cases = getStoredCases();
			renderMisExpedientes('');
			renderAuditoria('TODOS');
			renderMatriz(cases);
			updateBadgesAndCounters(cases);
		}

		function getStatusBadge(estado) {
			switch (estado) {
				case 'Pendiente':
					return '<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-black bg-amber-100 text-amber-900 border border-amber-300">🟡 Pendiente</span>';
				case 'Resuelto':
					return '<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-black bg-emerald-100 text-emerald-900 border border-emerald-300">🟢 Resuelto</span>';
				case 'No Resuelto':
					return '<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-black bg-orange-100 text-orange-900 border border-orange-300">🟠 No Resuelto</span>';
				case 'No Compete':
					return '<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-black bg-slate-200 text-slate-700 border border-slate-300">⚪ No Compete</span>';
				default:
					return `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-700">${estado}</span>`;
			}
		}

		function renderMisExpedientes(query) {
			const tbody = document.getElementById('tbody-mis-expedientes');
			const cases = getStoredCases();
			tbody.innerHTML = '';

			const filtered = cases.filter(c => {
				if (!query) return true;
				return (
					c.id.toLowerCase().includes(query) ||
					c.ciudadano.toLowerCase().includes(query) ||
					(c.ci && c.ci.includes(query)) ||
					(c.municipio && c.municipio.toLowerCase().includes(query))
				);
			});

			if (filtered.length === 0) {
				tbody.innerHTML = '<tr><td colspan="8" class="text-center py-6 text-slate-400">No se encontraron expedientes en el registro</td></tr>';
				return;
			}

			filtered.forEach(c => {
				const tr = document.createElement('tr');
				tr.className = 'hover:bg-slate-50 transition';
				tr.innerHTML = `
					<td class="px-3 py-2.5 font-mono font-bold text-blue-900">${c.id}</td>
					<td class="px-3 py-2.5 text-slate-600">${c.fecha}</td>
					<td class="px-3 py-2.5">
						<div class="font-bold text-slate-900">${c.ciudadano}</div>
						<div class="text-[10px] text-slate-500 font-mono">${c.municipio || 'Camagüey'} • CI: ${c.ci || '—'}</div>
					</td>
					<td class="px-3 py-2.5 text-center font-black ${c.competente ? 'text-emerald-700' : 'text-slate-400'}">
						${c.competente ? 'SÍ' : 'NO'}
					</td>
					<td class="px-3 py-2.5 font-semibold text-slate-700">${c.competente ? c.materia : '<span class="text-slate-400 italic">No Compete</span>'}</td>
					<td class="px-3 py-2.5 text-center font-mono font-black text-blue-900">${c.competente ? (c.vulnerabilidad || '—') : '<span class="text-slate-400">—</span>'}</td>
					<td class="px-3 py-2.5 text-center">${getStatusBadge(c.estado)}</td>
					<td class="px-3 py-2.5 text-center">
						<button type="button" class="btn-ver-caso px-3 py-1 rounded-lg bg-slate-100 hover:bg-[#0f2744] hover:text-white text-slate-800 font-bold text-[11px] border border-slate-300 transition">
							👁️ Ver Ficha
						</button>
					</td>
				`;
				tr.querySelector('.btn-ver-caso').addEventListener('click', () => abrirFichaLectura(c));
				tbody.appendChild(tr);
			});
		}

		function renderAuditoria(filtroEstado) {
			const tbody = document.getElementById('tbody-auditoria');
			const cases = getStoredCases();
			tbody.innerHTML = '';

			const filtered = cases.filter(c => {
				if (filtroEstado === 'TODOS') return true;
				return c.estado === filtroEstado;
			});

			if (filtered.length === 0) {
				tbody.innerHTML = '<tr><td colspan="7" class="text-center py-6 text-slate-400">No hay expedientes bajo este criterio de búsqueda</td></tr>';
				return;
			}

			filtered.forEach(c => {
				const tr = document.createElement('tr');
				tr.className = 'hover:bg-slate-50 transition';
				tr.innerHTML = `
					<td class="px-3 py-2.5 font-mono font-bold text-blue-900">${c.id}</td>
					<td class="px-3 py-2.5 text-slate-600">${c.fecha}</td>
					<td class="px-3 py-2.5">
						<div class="font-bold text-slate-900">${c.ciudadano}</div>
						<div class="text-[10px] text-slate-500 font-mono">${c.municipio || 'Camagüey'} • Atendió: ${c.responsable}</div>
					</td>
					<td class="px-3 py-2.5">
						${c.competente ? `<span class="font-bold text-slate-800">${c.materia}</span> <span class="font-mono text-blue-900 font-black text-[10px] bg-blue-100 px-1.5 py-0.5 rounded">(${c.vulnerabilidad})</span>` : '<span class="text-slate-400 italic">Descarte No Compete</span>'}
					</td>
					<td class="px-3 py-2.5 font-extrabold text-[#0f2744]">${c.via || '<span class="text-amber-700 italic font-medium">⚠️ Pendiente de Vía</span>'}</td>
					<td class="px-3 py-2.5 text-center">${getStatusBadge(c.estado)}</td>
					<td class="px-3 py-2.5 text-center">
						<button type="button" class="btn-auditar px-3.5 py-1.5 rounded-lg bg-blue-50 hover:bg-[#0f2744] hover:text-white text-[#0f2744] font-black text-[11px] border border-blue-300 transition shadow-sm">
							⚖️ Auditar / Dictaminar
						</button>
					</td>
				`;
				tr.querySelector('.btn-auditar').addEventListener('click', () => abrirAuditoriaDirectora(c));
				tbody.appendChild(tr);
			});
		}

		function updateBadgesAndCounters(cases) {
			const pendientes = cases.filter(c => c.estado === 'Pendiente').length;
			const resueltos = cases.filter(c => c.estado === 'Resuelto').length;
			const noCompete = cases.filter(c => c.estado === 'No Compete').length;

			document.getElementById('badge-pendientes-count').textContent = pendientes;
			document.getElementById('stat-total-atendidos').textContent = cases.length;
			document.getElementById('stat-total-pendientes').textContent = pendientes;
			document.getElementById('stat-total-resueltos').textContent = resueltos;
			document.getElementById('stat-total-nocompete').textContent = noCompete;
		}

		// ==================== CÁLCULO DE LA MATRIZ DE 20 COLUMNAS ====================
		function renderMatriz(cases) {
			const tbody = document.getElementById('tbody-matriz');
			const tfoot = document.getElementById('tfoot-matriz');
			tbody.innerHTML = '';
			tfoot.innerHTML = '';

			const meses = [
				'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
				'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'
			];

			const matrix = meses.map((mes, idx) => ({
				mes,
				mesIndex: idx,
				c1: 0, c2: 0,
				m1: 0, m2: 0, m3: 0, m4: 0, m5: 0,
				v1: 0, v2: 0, v3: 0, v4: 0, v5: 0,
				e1: 0, e2: 0, e3: 0,
				s1: 0, s2: 0, s3: 0, s4: 0
			}));

			const totalAnual = {
				c1: 0, c2: 0,
				m1: 0, m2: 0, m3: 0, m4: 0, m5: 0,
				v1: 0, v2: 0, v3: 0, v4: 0, v5: 0,
				e1: 0, e2: 0, e3: 0,
				s1: 0, s2: 0, s3: 0, s4: 0
			};

			cases.forEach(c => {
				const d = new Date(c.fecha);
				let mIdx = isNaN(d.getMonth()) ? 8 : d.getMonth();
				const row = matrix[mIdx];

				row.c1++;
				totalAnual.c1++;

				if (c.competente) {
					row.c2++;
					totalAnual.c2++;

					// Materias
					if (c.materia === 'Civil') { row.m1++; totalAnual.m1++; }
					else if (c.materia === 'Familiar') { row.m2++; totalAnual.m2++; }
					else if (c.materia === 'Trabajo y Seguridad Social') { row.m3++; totalAnual.m3++; }
					else if (c.materia === 'Mercantil') { row.m4++; totalAnual.m4++; }
					else if (c.materia === 'Administrativo') { row.m5++; totalAnual.m5++; }

					// Vulnerabilidades
					if (c.vulnerabilidad === 'NNA') { row.v1++; totalAnual.v1++; }
					else if (c.vulnerabilidad === 'VVD') { row.v2++; totalAnual.v2++; }
					else if (c.vulnerabilidad === 'PAM') { row.v3++; totalAnual.v3++; }
					else if (c.vulnerabilidad === 'PSD') { row.v4++; totalAnual.v4++; }
					else if (c.vulnerabilidad === 'PJA') { row.v5++; totalAnual.v5++; }

					// Vías
					if (c.via === 'Proceso Judicial') { row.s1++; totalAnual.s1++; }
					else if (c.via === 'Notarial') { row.s2++; totalAnual.s2++; }
					else if (c.via === 'Administrativo') { row.s3++; totalAnual.s3++; }
					else if (c.via === 'Métodos Alternos') { row.s4++; totalAnual.s4++; }
				} else {
					row.e3++;
					totalAnual.e3++;
				}

				// Estados
				if (c.estado === 'Resuelto') { row.e1++; totalAnual.e1++; }
				else if (c.estado === 'No Resuelto') { row.e2++; totalAnual.e2++; }
			});

			matrix.forEach((r, idx) => {
				const tr = document.createElement('tr');
				tr.className = idx % 2 === 0 ? 'bg-white hover:bg-slate-50' : 'bg-slate-50/60 hover:bg-slate-100';
				tr.innerHTML = `
					<td class="px-2 py-1.5 font-sans font-extrabold text-slate-900 text-left border-r border-slate-300">${r.mes}</td>
					<td class="px-1.5 py-1.5 font-black text-blue-950 bg-blue-50 border-r border-slate-200">${r.c1}</td>
					<td class="px-1.5 py-1.5 font-extrabold text-blue-900 bg-blue-50/40 border-r border-slate-300">${r.c2}</td>
					<td class="px-1.5 py-1.5 border-r border-slate-200">${r.m1}</td>
					<td class="px-1.5 py-1.5 border-r border-slate-200">${r.m2}</td>
					<td class="px-1.5 py-1.5 border-r border-slate-200">${r.m3}</td>
					<td class="px-1.5 py-1.5 border-r border-slate-200">${r.m4}</td>
					<td class="px-1.5 py-1.5 border-r border-slate-300">${r.m5}</td>
					<td class="px-1.5 py-1.5 border-r border-slate-200 font-bold">${r.v1}</td>
					<td class="px-1.5 py-1.5 border-r border-slate-200 font-bold">${r.v2}</td>
					<td class="px-1.5 py-1.5 border-r border-slate-200 font-bold">${r.v3}</td>
					<td class="px-1.5 py-1.5 border-r border-slate-200 font-bold">${r.v4}</td>
					<td class="px-1.5 py-1.5 border-r border-slate-300 font-bold">${r.v5}</td>
					<td class="px-1.5 py-1.5 border-r border-slate-200 text-emerald-800 font-black">${r.e1}</td>
					<td class="px-1.5 py-1.5 border-r border-slate-200 text-orange-800 font-black">${r.e2}</td>
					<td class="px-1.5 py-1.5 border-r border-slate-300 text-slate-600 font-black">${r.e3}</td>
					<td class="px-1.5 py-1.5 border-r border-slate-200">${r.s1}</td>
					<td class="px-1.5 py-1.5 border-r border-slate-200">${r.s2}</td>
					<td class="px-1.5 py-1.5 border-r border-slate-200">${r.s3}</td>
					<td class="px-1.5 py-1.5">${r.s4}</td>
				`;
				tbody.appendChild(tr);
			});

			tfoot.innerHTML = `
				<tr>
					<td class="px-2 py-2 font-sans font-black text-left border-r border-slate-700 bg-slate-950 text-white">TOTAL ANUAL</td>
					<td class="px-1.5 py-2 font-black text-blue-200 border-r border-slate-700 bg-[#0d223a]">${totalAnual.c1}</td>
					<td class="px-1.5 py-2 font-black text-blue-300 border-r border-slate-700 bg-[#0d223a]">${totalAnual.c2}</td>
					<td class="px-1.5 py-2 border-r border-slate-800">${totalAnual.m1}</td>
					<td class="px-1.5 py-2 border-r border-slate-800">${totalAnual.m2}</td>
					<td class="px-1.5 py-2 border-r border-slate-800">${totalAnual.m3}</td>
					<td class="px-1.5 py-2 border-r border-slate-800">${totalAnual.m4}</td>
					<td class="px-1.5 py-2 border-r border-slate-700">${totalAnual.m5}</td>
					<td class="px-1.5 py-2 border-r border-slate-800 text-amber-300 font-mono">${totalAnual.v1}</td>
					<td class="px-1.5 py-2 border-r border-slate-800 text-amber-300 font-mono">${totalAnual.v2}</td>
					<td class="px-1.5 py-2 border-r border-slate-800 text-amber-300 font-mono">${totalAnual.v3}</td>
					<td class="px-1.5 py-2 border-r border-slate-800 text-amber-300 font-mono">${totalAnual.v4}</td>
					<td class="px-1.5 py-2 border-r border-slate-700 text-amber-300 font-mono">${totalAnual.v5}</td>
					<td class="px-1.5 py-2 border-r border-slate-800 text-emerald-300 font-black">${totalAnual.e1}</td>
					<td class="px-1.5 py-2 border-r border-slate-800 text-orange-300 font-black">${totalAnual.e2}</td>
					<td class="px-1.5 py-2 border-r border-slate-700 text-slate-300 font-black">${totalAnual.e3}</td>
					<td class="px-1.5 py-2 border-r border-slate-800 text-blue-200">${totalAnual.s1}</td>
					<td class="px-1.5 py-2 border-r border-slate-800 text-blue-200">${totalAnual.s2}</td>
					<td class="px-1.5 py-2 border-r border-slate-800 text-blue-200">${totalAnual.s3}</td>
					<td class="px-1.5 py-2 text-blue-200">${totalAnual.s4}</td>
				</tr>
			`;

			const statusEl = document.getElementById('math-audit-status');
			const eq1 = (totalAnual.c1 === totalAnual.c2 + totalAnual.e3);
			const eq2 = (totalAnual.c2 === totalAnual.m1 + totalAnual.m2 + totalAnual.m3 + totalAnual.m4 + totalAnual.m5);
			const eq3 = (totalAnual.c2 === totalAnual.v1 + totalAnual.v2 + totalAnual.v3 + totalAnual.v4 + totalAnual.v5);

			if (eq1 && eq2 && eq3) {
				statusEl.className = 'px-3 py-0.5 rounded-full text-[11px] font-black bg-emerald-100 text-emerald-900 border border-emerald-300';
				statusEl.textContent = '✓ Todas las Ecuaciones Cuadran';
			} else {
				statusEl.className = 'px-3 py-0.5 rounded-full text-[11px] font-black bg-amber-100 text-amber-900 border border-amber-300';
				statusEl.textContent = '⚠️ Casos Pendientes de Calificar';
			}
		}

		// ==================== NOTIFICACIONES TOAST ====================
		let toastTimer = null;
		function showToast(msg, isSuccess = true) {
			const toast = document.getElementById('toast');
			const toastMsg = document.getElementById('toast-msg');
			const toastIcon = document.getElementById('toast-icon');

			toastMsg.textContent = msg;
			toastIcon.textContent = isSuccess ? '✓' : 'ℹ️';
			toast.className = `fixed bottom-5 right-5 z-50 px-4 py-3 rounded-xl shadow-xl text-xs font-black text-white flex items-center gap-2 transition duration-300 ${isSuccess ? 'bg-[#15803d]' : 'bg-slate-800'}`;
			toast.classList.remove('hidden');

			clearTimeout(toastTimer);
			toastTimer = setTimeout(() => {
				toast.classList.add('hidden');
			}, 3000);
		}

		document.addEventListener('DOMContentLoaded', initApp);
	</script>
</Layout>
