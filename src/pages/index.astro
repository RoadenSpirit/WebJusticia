							</div>
							<div>
								<div class="font-bold text-slate-900 text-sm leading-tight">${c.ciudadano_nombre}</div>
								<div class="text-xs text-slate-500 font-mono mt-0.5">${c.ciudadano_municipio} • CI: ${c.ciudadano_ci || '—'}</div>
							</div>
							<div class="grid grid-cols-2 gap-2 text-xs bg-slate-50 p-2.5 rounded-lg border border-slate-100">
								<div>
									<span class="text-[10px] uppercase font-bold text-slate-400 block">Materia / Vuln</span>
									<span class="font-semibold text-slate-800">${c.materia || 'No Compete'}</span>
									${vulns ? `<span class="text-[10px] font-mono text-slate-500 block">(${vulns})</span>` : ''}
