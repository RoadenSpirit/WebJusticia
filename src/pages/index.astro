---
import Layout from '../layouts/Layout.astro';
---

<Layout title="SIAC-JUS | Dirección Provincial de Justicia de Camagüey">
	<!-- ESTILOS GLOBALES DE CRAFT FLOOR (SELECCIÓN, SCROLLBARS, NÚMEROS TABULARES) -->
	<style is:global>
		::selection {
			background-color: #0c2340;
			color: #ffffff;
		}
		::-webkit-scrollbar {
			width: 8px;
			height: 8px;
		}
		::-webkit-scrollbar-track {
			background: #f1f5f9;
		}
		::-webkit-scrollbar-thumb {
			background: #cbd5e1;
			border-radius: 4px;
		}
		::-webkit-scrollbar-thumb:hover {
			background: #94a3b8;
		}
		.num-tabular {
			font-variant-numeric: tabular-nums;
		}
	</style>

	<div id="app" class="min-h-screen flex flex-col bg-slate-100 text-slate-900 font-sans antialiased">
		
		<!-- ==================== CINTILLO SUPERIOR DE LA REPÚBLICA ==================== -->
		<header class="bg-[#081626] text-slate-300 text-[11px] py-1.5 px-4 sm:px-6 border-b border-slate-800 flex items-center justify-between tracking-wide select-none">
			<div class="flex items-center gap-2">
				<span class="font-bold text-white uppercase tracking-wider">República de Cuba</span>
				<span class="text-slate-600">/</span>
				<span class="text-slate-200">Ministerio de Justicia (MINJUS)</span>
				<span class="hidden md:inline text-slate-600">/</span>
				<span class="hidden md:inline text-amber-300 font-medium italic">«Por un servicio jurídico ético, ágil y transparente»</span>
			</div>
			<div class="hidden sm:flex items-center gap-3 text-slate-400 text-[10px]">
				<span>Dirección Provincial • Camagüey</span>
				<span class="text-slate-600">•</span>
				<span id="fecha-oficial-hoy" class="font-medium text-slate-300"></span>
			</div>
		</header>

		<!-- ==================== PANTALLA 1: ACCESO AL SISTEMA (LOGIN) ==================== -->
		<div id="view-login" class="min-h-[calc(100vh-33px)] flex items-center justify-center p-4 bg-gradient-to-b from-[#0c2340] via-[#091b31] to-[#061222]">
			<div class="w-full max-w-md bg-white rounded-xl shadow-2xl border border-slate-200 overflow-hidden">
				
				<!-- Encabezado Institucional de Login -->
				<div class="bg-gradient-to-b from-[#0c2340] to-[#0a1e38] px-8 py-8 text-white text-center border-b border-slate-700/80 relative">
					<!-- Balanza SVG Oficial -->
					<div class="w-16 h-16 bg-[#16365c]/90 border border-amber-400/40 rounded-2xl flex items-center justify-center mx-auto mb-3.5 shadow-xl text-amber-400 ring-4 ring-blue-950/50">
						<svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
							<path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/>
							<path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/>
							<path d="M7 21h10"/>
							<path d="M12 3v18"/>
							<path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>
						</svg>
					</div>
					<h1 class="text-base font-extrabold tracking-tight uppercase text-white">Dirección Provincial de Justicia</h1>
					<p class="text-xs text-blue-200/90 font-medium mt-0.5">Camagüey, República de Cuba</p>
					<p class="text-[11px] text-amber-300 font-serif italic mt-1">«Por un servicio jurídico ético, ágil y transparente»</p>
					<div class="mt-3 inline-block px-3 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-blue-950/80 text-blue-200 border border-blue-400/30">
						SIAC-JUS • Sistema de Asesoría Jurídica
					</div>
				</div>

				<!-- Formulario -->
				<form id="form-login" class="p-8 space-y-4">
					<div id="login-error" class="hidden p-3 rounded-lg bg-rose-50 border border-rose-200 text-rose-800 text-xs font-semibold flex items-center gap-2">
						<svg class="w-4 h-4 text-rose-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
						<span id="login-error-text">Credenciales incorrectas. Verifique usuario y contraseña.</span>
					</div>

					<div>
						<label for="login-username" class="block text-[11px] font-bold text-slate-700 uppercase tracking-wider mb-1">
							Usuario Institucional
						</label>
						<input
							type="text"
							id="login-username"
							placeholder="Directora o Personal"
							required
							autocomplete="username"
							class="w-full px-3.5 py-2.5 text-sm rounded-lg border border-slate-300 focus:ring-2 focus:ring-[#0c2340] focus:border-[#0c2340] outline-none transition bg-slate-50 focus:bg-white"
						/>
					</div>

					<div>
						<label for="login-password" class="block text-[11px] font-bold text-slate-700 uppercase tracking-wider mb-1">
							Contraseña Institucional
						</label>
						<input
							type="password"
							id="login-password"
							placeholder="••••••••••••"
							required
							autocomplete="current-password"
							class="w-full px-3.5 py-2.5 text-sm rounded-lg border border-slate-300 focus:ring-2 focus:ring-[#0c2340] focus:border-[#0c2340] outline-none transition bg-slate-50 focus:bg-white"
						/>
					</div>

					<button
						type="submit"
						class="w-full py-2.5 px-4 rounded-lg bg-[#0c2340] hover:bg-[#16365c] active:bg-[#081626] text-white font-bold text-xs uppercase tracking-wider shadow transition duration-150 flex items-center justify-center gap-2"
					>
						<span>Acceder al Sistema</span>
						<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
					</button>

					<!-- Accesos directos de prueba -->
					<div class="pt-4 border-t border-slate-100 space-y-2">
						<p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider text-center">
							Accesos Rápidos
						</p>
						<div class="grid grid-cols-2 gap-2">
							<button
								type="button"
								id="btn-demo-directora"
								class="px-3 py-2 text-xs font-bold rounded-lg bg-slate-100 text-[#0c2340] border border-slate-200 hover:bg-slate-200 transition text-center"
							>
								Directora Provincial
							</button>
							<button
								type="button"
								id="btn-demo-personal"
								class="px-3 py-2 text-xs font-bold rounded-lg bg-slate-100 text-[#0c2340] border border-slate-200 hover:bg-slate-200 transition text-center"
							>
								Ventanilla de Atención
							</button>
						</div>
						<p class="text-[10px] text-slate-400 text-center font-mono">
							Clave por defecto: <strong class="text-slate-600">ASDasd123</strong>
						</p>
					</div>
				</form>
			</div>
		</div>

		<!-- ==================== PANTALLA PRINCIPAL DE OPERACIÓN ==================== -->
		<div id="view-dashboard" class="hidden flex-1 flex flex-col">
			
			<!-- BARRA DE CABECERA INSTITUCIONAL -->
			<nav class="bg-[#0c2340] text-white border-b border-slate-800 sticky top-0 z-30 shadow-md">
				<div class="max-w-7xl mx-auto px-3 sm:px-6 py-2 sm:py-2.5 flex items-center justify-between gap-2 sm:gap-3">
					<div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
						<div class="w-8 h-8 sm:w-9 sm:h-9 rounded-lg bg-[#16365c] border border-amber-400/40 flex items-center justify-center text-amber-400 shadow-inner shrink-0">
							<svg class="w-4 h-4 sm:w-5 sm:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
								<path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/>
								<path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/>
								<path d="M7 21h10"/>
								<path d="M12 3v18"/>
								<path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>
							</svg>
						</div>
						<div class="min-w-0">
							<div class="flex items-center gap-1.5 sm:gap-2 flex-wrap">
								<h2 class="font-extrabold text-xs sm:text-base tracking-tight leading-tight truncate">Web Estadística Justicia</h2>
								<span id="role-badge" class="px-1.5 py-0.2 sm:px-2 sm:py-0.5 rounded text-[9px] sm:text-[10px] font-extrabold uppercase tracking-wide shrink-0"></span>
							</div>
							<p class="text-[9px] sm:text-[10px] text-blue-200/90 font-medium truncate">
								Justicia Camagüey 
								<span class="hidden lg:inline text-amber-300/90 font-serif italic ml-2">«Ético, ágil y transparente»</span>
							</p>
						</div>
					</div>

					<div class="flex items-center gap-2 sm:gap-3 shrink-0">
						<div class="hidden sm:block text-right">
							<p id="user-display-name" class="text-xs font-bold text-white"></p>
							<p id="user-display-role" class="text-[10px] text-blue-300"></p>
						</div>
						<button
							id="btn-logout"
							class="px-2.5 sm:px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white text-xs font-semibold border border-slate-700 transition flex items-center gap-1.5 min-h-[38px] touch-manipulation"
							title="Cerrar Sesión"
						>
							<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
							<span class="hidden sm:inline">Cerrar Sesión</span>
							<span class="sm:hidden text-[11px]">Salir</span>
						</button>
					</div>
				</div>

				<!-- BARRA DE PESTAÑAS RESPONSIVE -->
				<div class="bg-[#081626] border-t border-slate-800/80 px-2 sm:px-6">
					<div class="max-w-7xl mx-auto flex space-x-1 sm:space-x-2 overflow-x-auto py-1.5 scroll-smooth no-scrollbar" id="main-nav">
						<button
							data-tab="tab-registro"
							class="nav-tab px-3 py-2 sm:px-3.5 text-xs font-bold rounded-md transition text-slate-300 hover:text-white flex items-center gap-1.5 sm:gap-2 shrink-0 touch-manipulation min-h-[42px]"
						>
							<svg class="w-3.5 h-3.5 text-blue-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
							<span>Registrar<span class="hidden sm:inline"> Comparecencia</span></span>
						</button>
						<button
							data-tab="tab-expedientes"
							class="nav-tab px-3 py-2 sm:px-3.5 text-xs font-bold rounded-md transition text-slate-300 hover:text-white flex items-center gap-1.5 sm:gap-2 shrink-0 touch-manipulation min-h-[42px]"
						>
							<svg class="w-3.5 h-3.5 text-blue-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
							<span>Expedientes<span class="hidden sm:inline"> Radicados</span></span>
						</button>
						<button
							data-tab="tab-auditoria"
							id="nav-tab-auditoria"
							class="nav-tab px-3 py-2 sm:px-3.5 text-xs font-bold rounded-md transition text-slate-300 hover:text-white flex items-center gap-1.5 sm:gap-2 shrink-0 touch-manipulation min-h-[42px]"
						>
							<svg class="w-3.5 h-3.5 text-amber-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 11 3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
							<span>Bandeja<span class="hidden sm:inline"> de Dirección</span></span>
							<span id="badge-pendientes-count" class="px-1.5 py-0.2 rounded-full text-[10px] font-extrabold bg-amber-400 text-slate-950">0</span>
						</button>
						<button
							data-tab="tab-matriz"
							id="nav-tab-matriz"
							class="nav-tab px-3 py-2 sm:px-3.5 text-xs font-bold rounded-md transition text-slate-300 hover:text-white flex items-center gap-1.5 sm:gap-2 shrink-0 touch-manipulation min-h-[42px]"
						>
							<svg class="w-3.5 h-3.5 text-emerald-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M3 15h18"/><path d="M9 3v18"/><path d="M15 3v18"/></svg>
							<span>Matriz<span class="hidden sm:inline"> Estadística Provincial</span></span>
						</button>
						<button
							data-tab="tab-ajustes"
							id="nav-tab-ajustes"
							class="nav-tab px-3 py-2 sm:px-3.5 text-xs font-bold rounded-md transition text-slate-300 hover:text-white flex items-center gap-1.5 sm:gap-2 shrink-0 touch-manipulation min-h-[42px]"
						>
							<svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
							<span>Ajustes<span class="hidden sm:inline"> de Dirección</span></span>
						</button>
					</div>
				</div>
			</nav>

			<!-- CONTENIDO PRINCIPAL -->
			<main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6">
				
				<!-- ==================== PESTAÑA 1: FORMULARIO DE REGISTRO ==================== -->
				<section id="tab-registro" class="tab-pane space-y-6">
					<div class="bg-white rounded-xl p-6 sm:p-8 border border-slate-200">
						
						<!-- Cabecera de Acta -->
						<div class="flex flex-col sm:flex-row sm:items-center justify-between pb-5 border-b border-slate-200 gap-2 mb-6">
							<div>
								<h3 class="text-lg font-black text-[#0c2340]">Acta de Radicación de Asesoría Jurídica</h3>
								<p class="text-xs text-slate-500">Atención presencial en ventanilla ministerial • Estado inicial: <strong>Radicado</strong></p>
							</div>
							<div class="text-right">
								<span class="text-xs font-mono font-bold text-slate-700 bg-slate-100 px-3 py-1.5 rounded-lg border border-slate-200 inline-flex items-center gap-1.5">
									<svg class="w-3.5 h-3.5 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
									<span>Sede Provincial Camagüey</span>
								</span>
							</div>
						</div>

						<form id="form-nuevo-expediente" class="space-y-6">
							
							<!-- I. DATOS DE RADICACIÓN (Entrada manual de número) -->
							<div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4 bg-slate-50 p-3.5 sm:p-4 rounded-xl border border-slate-200">
								<div>
									<label for="case-no" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
										No. de Expediente (Digitación Manual) <span class="text-rose-600">*</span>
									</label>
									<input
										type="text"
										id="case-no"
										required
										placeholder="EXP-2026-0001"
										class="w-full px-3.5 py-2.5 sm:py-2 bg-white text-slate-900 font-mono font-black text-base sm:text-sm rounded-lg border border-slate-300 focus:ring-2 focus:ring-[#0c2340] outline-none num-tabular"
									/>
									<p class="text-[10px] text-slate-500 mt-1">Compatible con el talonario físico preexistente</p>
								</div>

								<div>
									<label for="case-date" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
										Fecha de Atención <span class="text-rose-600">*</span>
									</label>
									<input
										type="date"
										id="case-date"
										required
										class="w-full px-3.5 py-2.5 sm:py-2 text-base sm:text-sm rounded-lg border border-slate-300 bg-white focus:ring-2 focus:ring-[#0c2340] outline-none font-medium"
									/>
								</div>
							</div>

							<!-- II. DATOS ESTRUCTURADOS DEL COMPARECIENTE -->
							<div class="space-y-3">
								<h4 class="text-xs font-black text-[#0c2340] uppercase tracking-wider flex items-center gap-1.5 border-b border-slate-100 pb-1">
									<span>I. Datos del Ciudadano Compareciente</span>
								</h4>

								<div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
									<div>
										<label for="case-ciudadano-nombre" class="block text-xs font-bold text-slate-600 uppercase mb-1">
											Nombre y Apellidos <span class="text-rose-600">*</span>
										</label>
										<input
											type="text"
											id="case-ciudadano-nombre"
											placeholder="Nombre completo"
											required
											class="w-full px-3.5 py-2.5 sm:py-2 text-base sm:text-sm rounded-lg border border-slate-300 bg-white focus:ring-2 focus:ring-[#0c2340] outline-none"
										/>
									</div>
									<div>
										<label for="case-ciudadano-ci" class="block text-xs font-bold text-slate-600 uppercase mb-1">
											Carnet de Identidad (o Documento)
										</label>
										<input
											type="text"
											id="case-ciudadano-ci"
											placeholder="CI de 11 dígitos o Pasaporte"
											class="w-full px-3.5 py-2.5 sm:py-2 text-base sm:text-sm font-mono num-tabular rounded-lg border border-slate-300 bg-white focus:ring-2 focus:ring-[#0c2340] outline-none"
										/>
									</div>
									<div>
										<label for="case-ciudadano-municipio" class="block text-xs font-bold text-slate-600 uppercase mb-1">
											Municipio de Residencia <span class="text-rose-600">*</span>
										</label>
										<select
											id="case-ciudadano-municipio"
											required
											class="w-full px-3.5 py-2.5 sm:py-2 text-base sm:text-sm rounded-lg border border-slate-300 bg-white focus:ring-2 focus:ring-[#0c2340] outline-none font-medium"
										>
											<option value="Camagüey">Camagüey (Cabecera)</option>
											<option value="Florida">Florida</option>
											<option value="Nuevitas">Nuevitas</option>
											<option value="Guáimaro">Guáimaro</option>
											<option value="Carlos M. de Céspedes">Carlos M. de Céspedes</option>
											<option value="Esmeralda">Esmeralda</option>
											<option value="Jimaguayú">Jimaguayú</option>
											<option value="Minas">Minas</option>
											<option value="Najasa">Najasa</option>
											<option value="Sibanicú">Sibanicú</option>
											<option value="Santa Cruz del Sur">Santa Cruz del Sur</option>
											<option value="Vertientes">Vertientes</option>
											<option value="Sierra de Cubitas">Sierra de Cubitas</option>
										</select>
									</div>
								</div>

								<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
									<div>
										<label for="case-ciudadano-direccion" class="block text-xs font-bold text-slate-600 uppercase mb-1">
											Dirección Particular
										</label>
										<input
											type="text"
											id="case-ciudadano-direccion"
											placeholder="Calle, No., entrecalles y reparto..."
											class="w-full px-3.5 py-2.5 sm:py-2 text-base sm:text-sm rounded-lg border border-slate-300 bg-white focus:ring-2 focus:ring-[#0c2340] outline-none"
										/>
									</div>
									<div>
										<label for="case-ciudadano-telefono" class="block text-xs font-bold text-slate-600 uppercase mb-1">
											Teléfono de Contacto
										</label>
										<input
											type="text"
											id="case-ciudadano-telefono"
											placeholder="Fijo o móvil"
											class="w-full px-3.5 py-2.5 sm:py-2 text-base sm:text-sm font-mono rounded-lg border border-slate-300 bg-white focus:ring-2 focus:ring-[#0c2340] outline-none"
										/>
									</div>
								</div>

