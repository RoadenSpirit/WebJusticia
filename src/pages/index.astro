		// Handlers de Autenticación
		function setupAuthHandlers() {
			const formLogin = document.getElementById('form-login');
			const btnDemoDir = document.getElementById('btn-demo-directora');
			const btnDemoPer = document.getElementById('btn-demo-personal');
			const btnLogout = document.getElementById('btn-logout');

			if (btnDemoDir) {
				btnDemoDir.addEventListener('click', () => {
					document.getElementById('login-username').value = 'Directora';
					document.getElementById('login-password').value = 'ASDasd123';
				});
			}

			if (btnDemoPer) {
				btnDemoPer.addEventListener('click', () => {
					document.getElementById('login-username').value = 'Personal';
					document.getElementById('login-password').value = 'ASDasd123';
				});
			}

			if (formLogin) {
				formLogin.addEventListener('submit', async (e) => {
					e.preventDefault();
					const username = document.getElementById('login-username').value.trim();
					const password = document.getElementById('login-password').value.trim();
					const errorEl = document.getElementById('login-error');

					try {
