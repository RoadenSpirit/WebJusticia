		// ==========================================
		// MOTOR DE BÚSQUEDA INTELIGENTE CLIENT-SIDE (IR)
		// Optimizado para conexiones lentas (< 500 kbps)
		// ==========================================
		const SPANISH_STOPWORDS = new Set([
			'de','la','que','el','en','y','a','los','del','se','las','por','un','para','con','no','una','su','al','lo','como','mas','pero','sus','le','ya','o','fue','este','ha','si','porque','esta','cuando','muy','sin','sobre','ser','tiene','tambien','me','hasta','hay','donde','quien','desde','todo','nos','durante','todos','uno','les','ni','contra','otros','ese','eso','ante','ellos','e','esto','mi','antes','algunos','que','unos','yo','otro','otras','otra','el','tanto','esa','estos','mucho','quienes','nada','muchos','cual','sea','poco','ella','estar','haber','estas','estaba','estamos','algunas','algo','nosotros'
		]);

		function normalizeText(str) {
			if (!str) return '';
			return str
				.toString()
				.normalize('NFD')
				.replace(/[\u0300-\u036f]/g, '') // Quitar tildes y diacríticos
				.toLowerCase()
				.replace(/[^a-z0-9\s]/g, ' ') // Quitar puntuación y símbolos
				.replace(/\s+/g, ' ')
				.trim();
		}

		// Stemmer heurístico simplificado en español (Porter-like adaptado)
		function stemSpanish(word) {
			if (!word || word.length <= 3) return word;
			let w = word;
			// Sufijos verbales y nominales comunes
			w = w.replace(/(es|s)$/, '');
			w = w.replace(/(mente|imiento|adora|ador|acion|ado|ada|ados|adas|ero|era|eros|eras)$/, '');
			w = w.replace(/(ando|iendo|ar|er|ir|aron|ieron|aba|iba)$/, '');
			return w.length >= 3 ? w : word;
		}

		function extractSearchTerms(rawQuery) {
			const clean = normalizeText(rawQuery);
			if (!clean) return [];
			const tokens = clean.split(' ').filter(t => t.length > 1 && !SPANISH_STOPWORDS.has(t));
			return tokens.map(t => ({
				raw: t,
				stem: stemSpanish(t),
				isNum: /^\d+$/.test(t)
			}));
		}

		// Calcula relevancia ponderada de un expediente frente a los términos de búsqueda
		function scoreCase(c, queryTerms) {
			if (!queryTerms || queryTerms.length === 0) return 0;

			// Campos indexados con sus pesos
			const fields = [
				{ text: normalizeText(c.no_expediente), weight: 100 },
				{ text: normalizeText(c.ciudadano_ci), weight: 80 },
				{ text: normalizeText(c.ciudadano_nombre), weight: 50 },
				{ text: normalizeText(c.responsable), weight: 25 },
				{ text: normalizeText(c.materia), weight: 15 },
				{ text: normalizeText(c.ciudadano_municipio), weight: 15 },
				{ text: normalizeText(c.fundamentos), weight: 5 }
			];

			let totalScore = 0;
			let termsMatched = 0;

			for (const term of queryTerms) {
				let matchedThisTerm = false;

				for (const field of fields) {
					if (!field.text) continue;

					// Match exacto o coincidencia de subcadena directa
					if (field.text.includes(term.raw)) {
						totalScore += field.weight * 1.0;
						matchedThisTerm = true;
						continue;
					}

					// Si no es un número puro, probar con raíz lematizada
					if (!term.isNum && term.stem.length >= 3) {
						// Tokenizar campo y comprobar raíces
						const fieldTokens = field.text.split(' ');
						for (const ft of fieldTokens) {
							const fStem = stemSpanish(ft);
							if (fStem.startsWith(term.stem) || term.stem.startsWith(fStem)) {
								totalScore += field.weight * 0.6; // Coincidencia morfológica
								matchedThisTerm = true;
								break;
							}
						}
					}
				}

				if (matchedThisTerm) {
					termsMatched++;
				}
			}

			// Bonificación por coincidencia multi-término
			if (queryTerms.length > 1 && termsMatched === queryTerms.length) {
				totalScore *= 1.5;
			}

			return termsMatched > 0 ? totalScore : 0;
		}

		// Renderizado: Bandeja de Auditoría (Casos Radicados primero + Búsqueda Inteligente Ponderada)
		function renderizarBandejaAuditoria() {
			const tbody = document.getElementById('tbody-auditoria');
			const cardsContainer = document.getElementById('cards-auditoria');
			if (!tbody) return;

			const filtroEstado = document.getElementById('filter-auditoria-estado')?.value || 'TODOS';
			const rawQuery = document.getElementById('search-auditoria')?.value || '';
			const queryTerms = extractSearchTerms(rawQuery);

			// 1. Filtrar por estado si aplica
			let baseList = appState.cases.filter(c => {
				if (filtroEstado === 'TODOS') return true;
				return c.estado_caso === filtroEstado;
			});

			let filtrados = [];

			if (queryTerms.length > 0) {
				// 2a. Si hay búsqueda activa: calcular score y ordenar por relevancia
				const scored = [];
				for (const c of baseList) {
					const score = scoreCase(c, queryTerms);
					if (score > 0) {
						scored.push({ caso: c, score });
					}
				}
				scored.sort((a, b) => {
					if (b.score !== a.score) return b.score - a.score;
					return (b.caso.fecha_atencion || '').localeCompare(a.caso.fecha_atencion || '');
				});
				filtrados = scored.map(s => s.caso);
			} else {
				// 2b. Sin búsqueda: Radicados al principio con máxima prioridad, luego cronológico desc
				filtrados = [...baseList].sort((a, b) => {
					const aRadicado = a.estado_caso === 'Radicado' ? 0 : 1;
					const bRadicado = b.estado_caso === 'Radicado' ? 0 : 1;
					if (aRadicado !== bRadicado) return aRadicado - bRadicado;
					// Si ambos son del mismo grupo, ordenar por fecha descendente y luego id desc
					const fechaDiff = (b.fecha_atencion || '').localeCompare(a.fecha_atencion || '');
					if (fechaDiff !== 0) return fechaDiff;
					return (b.id || 0) - (a.id || 0);
				});
			}

			if (filtrados.length === 0) {
				tbody.innerHTML = `<tr><td colspan="8" class="text-center py-8 text-slate-400">No se encontraron expedientes que coincidan con la búsqueda o filtro seleccionado.</td></tr>`;
				if (cardsContainer) {
					cardsContainer.innerHTML = `<div class="text-center py-8 text-slate-400 bg-white rounded-xl border border-slate-200">No se encontraron expedientes que coincidan con la búsqueda o filtro seleccionado.</div>`;
				}
				return;
			}

			// Renderizado Tabla Escritorio (>= 768px)
			tbody.innerHTML = filtrados.map(c => {
				const badgeEstado = getBadgeColorClase(c.estado_caso);
				const rowBg = getRowColorClase(c.estado_caso);
				const vulns = Array.isArray(c.vulnerabilidades) ? c.vulnerabilidades.join(', ') : '';

				return `
					<tr class="${rowBg} border-b border-slate-200 transition">
						<td class="px-3 py-3 font-mono font-bold text-[#0c2340] num-tabular">${c.no_expediente}</td>
						<td class="px-3 py-3 text-slate-700 font-medium num-tabular">${c.fecha_atencion}</td>
						<td class="px-3 py-3">
							<div class="font-bold text-slate-900">${c.ciudadano_nombre}</div>
							<div class="text-[10px] text-slate-500 font-mono num-tabular">${c.ciudadano_municipio} • CI: ${c.ciudadano_ci || '—'}</div>
						</td>
						<td class="px-3 py-3">
							<div class="font-semibold text-slate-800">${c.materia || 'No Compete'}</div>
