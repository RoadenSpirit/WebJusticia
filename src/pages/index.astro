								return;
							}
						}
					} catch (err) {
						// Fallback local si la API estuviese offline
						if (password === 'ASDasd123' && (username.toLowerCase() === 'directora' || username.toLowerCase() === 'personal')) {
							const isDir = username.toLowerCase() === 'directora';
							appState.user = {
								username: isDir ? 'Directora' : 'Personal',
								rol: isDir ? 'Directora' : 'Personal',
