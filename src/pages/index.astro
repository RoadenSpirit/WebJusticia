			}

			setupAuthHandlers();
			setupNavHandlers();
			setupFormSelectors();
			setupFormSubmit();
			setupModalHandlers();
			setupAjustesHandlers();

			// Restaurar sesión si existe
			const savedUser = localStorage.getItem('siac_jus_user');
			if (savedUser) {
				try {
					appState.user = JSON.parse(savedUser);
					showDashboard();
				} catch (e) {
