							<div class="grid grid-cols-2 gap-2 text-xs bg-slate-50 p-2.5 rounded-lg border border-slate-100">
								<div>
									<span class="text-[10px] uppercase font-bold text-slate-400 block">Competencia</span>
									<span class="font-bold ${c.es_competente ? 'text-emerald-700' : 'text-slate-500'}">
