			const statAtendidos = document.getElementById('stat-total-atendidos');
			const statRadicados = document.getElementById('stat-total-radicados');
			const statTramite = document.getElementById('stat-total-tramite');
			const statConcluidos = document.getElementById('stat-total-concluidos');
			const badgePendientes = document.getElementById('badge-pendientes-count');
			const badgePapelera = document.getElementById('badge-papelera-count');

			if (statAtendidos) statAtendidos.textContent = totalAtendidos;
			if (statRadicados) statRadicados.textContent = radicados;
			if (statTramite) statTramite.textContent = enTramite;
			if (statConcluidos) statConcluidos.textContent = concluidos;
