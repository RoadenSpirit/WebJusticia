								</div>
								<div class="flex items-center gap-1.5">
									<span class="text-[11px] text-slate-500 font-mono num-tabular">${c.fecha_atencion}</span>
									<span class="px-2 py-0.5 rounded text-[10px] font-black uppercase tracking-wider ${badgeEstado}">
