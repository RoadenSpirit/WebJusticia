									<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
									Gestionar
								</button>
								<button onclick="abrirModalEditar(${c.id})" class="min-h-[42px] px-3.5 py-2 rounded-lg bg-slate-100 active:bg-slate-200 text-slate-700 font-bold text-xs border border-slate-300 flex items-center justify-center transition" title="Editar">
									✎
								</button>
								<a href="${API_BASE}/pdf.php?id=${c.id}&format=pdf" target="_blank" class="min-h-[42px] px-3.5 py-2 rounded-lg bg-amber-100 active:bg-amber-200 text-amber-950 font-bold text-xs border border-amber-300 flex items-center justify-center font-mono transition" title="Descargar Ficha en PDF (.pdf)">
									PDF
								</a>
							</div>
						</article>
					`;
				}).join('');
			}
		}

		// Gama de colores de estado (Semántica institucional visual)
		function getBadgeColorClase(estado) {
			switch (estado) {
				case 'Radicado':
					return 'bg-amber-100 text-amber-950 border border-amber-400';
				case 'En Trámite':
					return 'bg-sky-100 text-sky-950 border border-sky-400';
				case 'Concluido':
					return 'bg-emerald-100 text-emerald-950 border border-emerald-400';
				case 'No Compete':
				default:
					return 'bg-slate-200 text-slate-800 border border-slate-300';
			}
		}

		function getRowColorClase(estado) {
			switch (estado) {
				case 'Radicado':
					return 'bg-amber-50/60 hover:bg-amber-100/60';
				case 'En Trámite':
					return 'bg-sky-50/50 hover:bg-sky-100/50';
				case 'Concluido':
					return 'bg-emerald-50/40 hover:bg-emerald-100/40';
				case 'No Compete':
				default:
					return 'bg-white hover:bg-slate-50';
			}
		}

		// Renderizado: Papelera
		function renderizarPapelera() {
			const tbody = document.getElementById('tbody-papelera');
			if (!tbody) return;

			if (appState.papelera.length === 0) {
				tbody.innerHTML = `<tr><td colspan="6" class="text-center py-8 text-slate-400">La papelera está vacía</td></tr>`;
				return;
			}

			tbody.innerHTML = appState.papelera.map(c => `
				<tr class="hover:bg-slate-50 transition">
					<td class="px-3 py-2.5 font-mono font-bold text-slate-700">${c.no_expediente}</td>
					<td class="px-3 py-2.5 text-slate-600">${c.fecha_atencion}</td>
					<td class="px-3 py-2.5 font-bold text-slate-900">${c.ciudadano_nombre}</td>
					<td class="px-3 py-2.5 text-slate-700 font-semibold">${c.usuario_eliminacion || 'Directora'}</td>
					<td class="px-3 py-2.5 text-slate-600 italic">${c.motivo_eliminacion || 'Sin motivo'}</td>
					<td class="px-3 py-2.5 text-center">
						<button onclick="restaurarExpediente(${c.id})" class="px-3 py-1.5 rounded-lg bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs shadow transition">
							Restaurar
						</button>
					</td>
				</tr>
			`).join('');
		}

		// Gestión de Usuarios (Ajustes de Dirección)
		async function cargarUsuariosDesdeServidor() {
			try {
				const res = await fetch(`${API_BASE}/usuarios.php`);
				if (res.ok) {
					const data = await res.json();
					if (data.success) {
						appState.usuarios = data.usuarios;
						renderizarUsuarios();
					}
				}
			} catch (e) {
				console.warn('Error cargando usuarios:', e);
			}
		}

		function renderizarUsuarios() {
			const tbody = document.getElementById('tbody-usuarios-ajustes');
			if (!tbody) return;

			if (!appState.usuarios || appState.usuarios.length === 0) {
				tbody.innerHTML = `<tr><td colspan="5" class="text-center py-6 text-slate-400">No hay usuarios cargados</td></tr>`;
				return;
			}

			tbody.innerHTML = appState.usuarios.map(u => {
				const isRoot = u.username.toLowerCase() === 'directora';
				const badgeRol = u.rol === 'Directora' 
					? 'bg-amber-100 text-amber-950 border border-amber-300' 
					: 'bg-blue-100 text-blue-950 border border-blue-300';
				return `
					<tr class="hover:bg-slate-50 transition">
						<td class="px-3 py-2 font-mono font-bold text-[#0c2340]">${u.username}</td>
						<td class="px-3 py-2 font-semibold text-slate-800">${u.nombre_completo}</td>
						<td class="px-3 py-2 text-center">
							<span class="px-2 py-0.5 rounded text-[10px] font-bold ${badgeRol}">
								${u.rol === 'Directora' ? 'Dirección Provincial' : 'Ventanilla'}
							</span>
						</td>
						<td class="px-3 py-2 text-slate-500 font-mono text-[11px]">${u.created_at || '—'}</td>
						<td class="px-3 py-2 text-center">
							${isRoot 
								? '<span class="text-slate-400 text-[10px] italic">Cuenta Principal</span>' 
								: `<button onclick="eliminarUsuario(${u.id}, '${u.username}')" class="px-2.5 py-1 rounded bg-rose-50 hover:bg-rose-100 text-rose-700 font-bold text-[11px] border border-rose-200 transition">Eliminar</button>`}
						</td>
					</tr>
				`;
			}).join('');
		}

		function setupAjustesHandlers() {
			// Formulario Crear Usuario
			const formUser = document.getElementById('form-crear-usuario');
			if (formUser) {
				formUser.addEventListener('submit', async (e) => {
					e.preventDefault();
					const username = document.getElementById('new-user-username').value.trim();
					const nombre = document.getElementById('new-user-nombre').value.trim();
					const password = document.getElementById('new-user-password').value.trim();
					const rol = document.getElementById('new-user-rol').value;

					try {
						const res = await fetch(`${API_BASE}/usuarios.php`, {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({
								username,
								nombre_completo: nombre,
								password,
								rol,
								creado_por: appState.user ? appState.user.username : 'Directora'
							})
						});

						const data = await res.json();
						if (res.ok && data.success) {
							mostrarToast(`Usuario '${username}' creado con éxito.`);
							formUser.reset();
							cargarUsuariosDesdeServidor();
						} else {
							alert(data.error || 'Error al crear usuario');
						}
					} catch (err) {
						alert('Error de conexión al crear usuario');
					}
				});
			}

			// Botón Cargar 30 Casos de Prueba
			const btnSeed = document.getElementById('btn-cargar-30-casos');
			if (btnSeed) {
				btnSeed.addEventListener('click', async () => {
					if (!confirm('¿Confirma que desea poblar la base de datos con los 30 casos de prueba estandarizados? Se inicializará la base de datos con expedientes en varios municipios y estados para la Matriz.')) {
						return;
					}

					try {
						mostrarToast('Poblando base de datos espejo...');
						const res = await fetch(`${API_BASE}/seed.php?action=poblar`);
						if (res.ok) {
							const data = await res.json();
							mostrarToast(data.message || '30 casos cargados con éxito.');
							cargarExpedientesDesdeServidor();
							return;
						}
					} catch (e) {}

					alert('Error al conectar con el generador de base de datos espejo.');
				});
			}
		}

		window.eliminarUsuario = async function(id, username) {
			if (!confirm(`¿Está segura de que desea eliminar al usuario '${username}'?`)) return;

			try {
				const res = await fetch(`${API_BASE}/usuarios.php?id=${id}`, {
					method: 'DELETE',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ id, eliminado_por: appState.user ? appState.user.username : 'Directora' })
				});

				const data = await res.json();
				if (res.ok && data.success) {
					mostrarToast(`Usuario '${username}' eliminado.`);
					cargarUsuariosDesdeServidor();
				} else {
					alert(data.error || 'No se pudo eliminar el usuario');
				}
			} catch (e) {
				alert('Error al eliminar usuario');
			}
		};

		// Renderizado: Matriz Anual Oficial Adaptada
		function renderizarMatrizEstadistica() {
			const tbody = document.getElementById('tbody-matriz');
			const tfoot = document.getElementById('tfoot-matriz');
			if (!tbody || !tfoot) return;

			const meses = [
				'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
				'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'
			];

			let totales = {
				c1: 0, c2: 0, c3: 0,
				civil: 0, fam: 0, trab: 0, merc: 0, adm_mat: 0,
				nna: 0, vvd: 0, pam: 0, psd: 0, pja: 0,
				radicado: 0, tramite: 0, concluido: 0, no_compete_est: 0,
				jud: 0, not: 0, adm_via: 0, alt: 0,
				apto_pago: 0
			};

			const rows = meses.map((mesNombre, mesIndex) => {
				const mCases = appState.cases.filter(c => {
					if (!c.fecha_atencion) return false;
					const mesCaso = new Date(c.fecha_atencion).getMonth();
					return mesCaso === mesIndex;
				});

				const c1 = mCases.length;
				const c2 = mCases.filter(c => c.es_competente).length;
				const c3 = mCases.filter(c => !c.es_competente).length;

				const civil = mCases.filter(c => c.es_competente && c.materia === 'Civil').length;
				const fam = mCases.filter(c => c.es_competente && c.materia === 'Familiar').length;
				const trab = mCases.filter(c => c.es_competente && c.materia === 'Trabajo y Seguridad Social').length;
				const merc = mCases.filter(c => c.es_competente && c.materia === 'Mercantil').length;
				const adm_mat = mCases.filter(c => c.es_competente && c.materia === 'Administrativo').length;

				// Vulnerabilidades múltiples independientes
				const nna = mCases.filter(c => c.es_competente && Array.isArray(c.vulnerabilidades) && c.vulnerabilidades.includes('NNA')).length;
				const vvd = mCases.filter(c => c.es_competente && Array.isArray(c.vulnerabilidades) && c.vulnerabilidades.includes('VVD')).length;
				const pam = mCases.filter(c => c.es_competente && Array.isArray(c.vulnerabilidades) && c.vulnerabilidades.includes('PAM')).length;
				const psd = mCases.filter(c => c.es_competente && Array.isArray(c.vulnerabilidades) && c.vulnerabilidades.includes('PSD')).length;
				const pja = mCases.filter(c => c.es_competente && Array.isArray(c.vulnerabilidades) && c.vulnerabilidades.includes('PJA')).length;

				const radicado = mCases.filter(c => c.estado_caso === 'Radicado').length;
				const tramite = mCases.filter(c => c.estado_caso === 'En Trámite').length;
				const concluido = mCases.filter(c => c.estado_caso === 'Concluido').length;
				const no_compete_est = c3;

				const jud = mCases.filter(c => c.es_competente && c.via_solucion === 'Proceso Judicial').length;
				const not = mCases.filter(c => c.es_competente && c.via_solucion === 'Notarial').length;
				const adm_via = mCases.filter(c => c.es_competente && c.via_solucion === 'Administrativo').length;
				const alt = mCases.filter(c => c.es_competente && c.via_solucion === 'Métodos Alternos').length;

				const apto_pago = mCases.filter(c => c.apto_pago).length;

				// Acumular
				totales.c1 += c1; totales.c2 += c2; totales.c3 += c3;
				totales.civil += civil; totales.fam += fam; totales.trab += trab; totales.merc += merc; totales.adm_mat += adm_mat;
				totales.nna += nna; totales.vvd += vvd; totales.pam += pam; totales.psd += psd; totales.pja += pja;
				totales.radicado += radicado; totales.tramite += tramite; totales.concluido += concluido; totales.no_compete_est += no_compete_est;
				totales.jud += jud; totales.not += not; totales.adm_via += adm_via; totales.alt += alt;
				totales.apto_pago += apto_pago;

				return `
					<tr class="hover:bg-slate-50 group">
						<td class="sticky left-0 z-10 px-2.5 py-1.5 font-bold text-left border-r border-slate-300 bg-white group-hover:bg-slate-50 shadow-[2px_0_4px_rgba(0,0,0,0.06)]">${mesNombre}</td>
						<td class="px-1.5 py-1.5 font-black text-blue-950 bg-blue-50/50 border-r border-slate-200">${c1 || '—'}</td>
						<td class="px-1.5 py-1.5 font-bold text-blue-800 border-r border-slate-200">${c2 || '—'}</td>
						<td class="px-1.5 py-1.5 text-slate-500 border-r border-slate-300">${c3 || '—'}</td>
						<td class="px-1.5 py-1.5 border-r border-slate-200">${civil || '—'}</td>
						<td class="px-1.5 py-1.5 border-r border-slate-200">${fam || '—'}</td>
						<td class="px-1.5 py-1.5 border-r border-slate-200">${trab || '—'}</td>
						<td class="px-1.5 py-1.5 border-r border-slate-200">${merc || '—'}</td>
						<td class="px-1.5 py-1.5 border-r border-slate-300">${adm_mat || '—'}</td>
						<td class="px-1.5 py-1.5 border-r border-slate-200 font-mono">${nna || '—'}</td>
						<td class="px-1.5 py-1.5 border-r border-slate-200 font-mono">${vvd || '—'}</td>
						<td class="px-1.5 py-1.5 border-r border-slate-200 font-mono">${pam || '—'}</td>
						<td class="px-1.5 py-1.5 border-r border-slate-200 font-mono">${psd || '—'}</td>
						<td class="px-1.5 py-1.5 border-r border-slate-300 font-mono">${pja || '—'}</td>
						<td class="px-1.5 py-1.5 border-r border-slate-200 font-bold text-amber-900 bg-amber-50/40">${radicado || '—'}</td>
						<td class="px-1.5 py-1.5 border-r border-slate-200 font-bold text-sky-900 bg-sky-50/40">${tramite || '—'}</td>
						<td class="px-1.5 py-1.5 border-r border-slate-200 font-bold text-emerald-900 bg-emerald-50/40">${concluido || '—'}</td>
						<td class="px-1.5 py-1.5 border-r border-slate-300 font-bold text-slate-600">${no_compete_est || '—'}</td>
						<td class="px-1.5 py-1.5 border-r border-slate-200">${jud || '—'}</td>
						<td class="px-1.5 py-1.5 border-r border-slate-200">${not || '—'}</td>
						<td class="px-1.5 py-1.5 border-r border-slate-200">${adm_via || '—'}</td>
						<td class="px-1.5 py-1.5 border-r border-slate-300">${alt || '—'}</td>
						<td class="px-1.5 py-1.5 font-bold text-amber-950 bg-amber-50">${apto_pago || '—'}</td>
					</tr>
				`;
			}).join('');

			tbody.innerHTML = rows;

			tfoot.innerHTML = `
				<tr>
					<td class="sticky left-0 z-10 px-2 py-2 text-left uppercase border-r border-slate-700 bg-[#0c2340] shadow-[2px_0_4px_rgba(0,0,0,0.06)]">Total Anual</td>
					<td class="px-1.5 py-2 border-r border-slate-700 bg-blue-900">${totales.c1}</td>
					<td class="px-1.5 py-2 border-r border-slate-700">${totales.c2}</td>
					<td class="px-1.5 py-2 border-r border-slate-700 text-slate-300">${totales.c3}</td>
					<td class="px-1.5 py-2 border-r border-slate-700">${totales.civil}</td>
					<td class="px-1.5 py-2 border-r border-slate-700">${totales.fam}</td>
					<td class="px-1.5 py-2 border-r border-slate-700">${totales.trab}</td>
					<td class="px-1.5 py-2 border-r border-slate-700">${totales.merc}</td>
					<td class="px-1.5 py-2 border-r border-slate-700">${totales.adm_mat}</td>
					<td class="px-1.5 py-2 border-r border-slate-700">${totales.nna}</td>
					<td class="px-1.5 py-2 border-r border-slate-700">${totales.vvd}</td>
					<td class="px-1.5 py-2 border-r border-slate-700">${totales.pam}</td>
					<td class="px-1.5 py-2 border-r border-slate-700">${totales.psd}</td>
					<td class="px-1.5 py-2 border-r border-slate-700">${totales.pja}</td>
					<td class="px-1.5 py-2 border-r border-slate-700 text-amber-300">${totales.radicado}</td>
					<td class="px-1.5 py-2 border-r border-slate-700 text-sky-300">${totales.tramite}</td>
					<td class="px-1.5 py-2 border-r border-slate-700 text-emerald-300">${totales.concluido}</td>
					<td class="px-1.5 py-2 border-r border-slate-700 text-slate-300">${totales.no_compete_est}</td>
					<td class="px-1.5 py-2 border-r border-slate-700">${totales.jud}</td>
					<td class="px-1.5 py-2 border-r border-slate-700">${totales.not}</td>
					<td class="px-1.5 py-2 border-r border-slate-700">${totales.adm_via}</td>
					<td class="px-1.5 py-2 border-r border-slate-700">${totales.alt}</td>
					<td class="px-1.5 py-2 bg-amber-900 text-amber-200">${totales.apto_pago}</td>
				</tr>
			`;

			// Actualizar KPIs de resumen ejecutivo para dispositivos móviles
			const kpiTotal = document.getElementById('matriz-kpi-total');
			const kpiComp = document.getElementById('matriz-kpi-comp');
			const kpiConcluido = document.getElementById('matriz-kpi-concluido');
			const kpiPago = document.getElementById('matriz-kpi-pago');
			if (kpiTotal) kpiTotal.textContent = totales.c1;
			if (kpiComp) kpiComp.textContent = totales.c2;
			if (kpiConcluido) kpiConcluido.textContent = totales.concluido;
			if (kpiPago) kpiPago.textContent = totales.apto_pago;
		}

		function actualizarBadgesYMetricas() {
			const totalAtendidos = appState.cases.length;
			const radicados = appState.cases.filter(c => c.estado_caso === 'Radicado').length;
			const enTramite = appState.cases.filter(c => c.estado_caso === 'En Trámite').length;
