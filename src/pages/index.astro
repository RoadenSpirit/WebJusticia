				const nextNum = String(appState.cases.length + 1).padStart(4, '0');
				input.value = `EXP-${year}-${nextNum}`;
			}
		}

		// API Fetch Helpers
		async function cargarExpedientesDesdeServidor() {
			try {
				const res = await fetch(`${API_BASE}/expedientes.php`);
				if (res.ok) {
					const data = await res.json();
					if (data.success) {
						appState.cases = data.expedientes;
						localStorage.setItem('siac_jus_cached_cases', JSON.stringify(appState.cases));
					}
				}
			} catch (err) {
				console.warn('Servidor offline o inaccesible, usando cache:', err);
				const cached = localStorage.getItem('siac_jus_cached_cases');
				if (cached) appState.cases = JSON.parse(cached);
			}

			if (appState.user && appState.user.rol === 'Directora') {
				cargarPapeleraDesdeServidor();
			}

			renderizarTodo();
		}

		async function cargarPapeleraDesdeServidor() {
			try {
				const res = await fetch(`${API_BASE}/expedientes.php?papelera=1`);
				if (res.ok) {
					const data = await res.json();
					if (data.success) {
						appState.papelera = data.expedientes;
					}
				}
